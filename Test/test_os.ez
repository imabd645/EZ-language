use "os" as ov

out "============================================="
out "      PURE EZ OS LIBRARY VERIFICATION        "
out "============================================="

out "Platform      : " + ov.sys.platform()
out "Uptime (sec)  : " + str(ov.sys.uptime())

# Memory Status verification
totalMem = ov.sys.totalMemory() / (1024 * 1024)
freeMem = ov.sys.freeMemory() / (1024 * 1024)
out "Total Memory  : " + str(totalMem) + " MB"
out "Free Memory   : " + str(freeMem) + " MB"

# Environment manipulation
ov.env.set("TEST_EZ_VAR", "NativeFFIWorks!")
out "ENV Variable  : " + ov.env.get("TEST_EZ_VAR")

# Directory navigation
currDir = ov.sys.cwd()
out "Current Dir   : " + currDir

# Clipboard Interaction
readPre = ov.clipboard.read()
ov.clipboard.write("Hello from pure EZ FFI Clipboard!")
readPost = ov.clipboard.read()
out "Clipboard Get : " + readPost

# Exec verification
execOut = ov.process.exec("echo Pure OS Process Exec Works")
out "Exec Output   : " + execOut

out "============================================="
out "     ALL OS SUBSYSTEMS NATIVELY PASSED!      "
