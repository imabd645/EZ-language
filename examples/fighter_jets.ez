use "game"

WIDTH = 600
HEIGHT = 800

app = createGame("EZ Fighter Jets 🛩️", WIDTH, HEIGHT)
app.setFPS(60)

# --- Game State ---
# Player
playerX = WIDTH / 2
playerY = HEIGHT - 100
playerSpeed = 6
playerSize = 30
score = 0
gameOver = false

# Bullets: [[x, y], ...]
bullets = []
bulletSpeed = 10

# Enemies: [[x, y, speed], ...]
enemies = []

# Timers
lastShoot = 0
enemySpawnTimer = 0

task resetGame() {
    playerX = WIDTH / 2
    playerY = HEIGHT - 100
    score = 0
    gameOver = false
    bullets = []
    enemies = []
    lastShoot = 0
    enemySpawnTimer = 0
}

# --- Physics & Logic ---
app.onUpdateCall(|| {
    when gameOver {
        # Check restart
        when app.isKeyDown(KEYS.SPACE) {
            resetGame()
        }
        give false
    }

    # Player Movement
    when app.isKeyDown(KEYS.LEFT) or app.isKeyDown(KEYS.A) {
        playerX = playerX - playerSpeed
    }
    when app.isKeyDown(KEYS.RIGHT) or app.isKeyDown(KEYS.D) {
        playerX = playerX + playerSpeed
    }
    when app.isKeyDown(KEYS.UP) or app.isKeyDown(KEYS.W) {
        playerY = playerY - playerSpeed
    }
    when app.isKeyDown(KEYS.DOWN) or app.isKeyDown(KEYS.S) {
        playerY = playerY + playerSpeed
    }

    # Clamp player to screen
    when playerX < 0 { playerX = 0 }
    when playerX > WIDTH - playerSize { playerX = WIDTH - playerSize }
    when playerY < 0 { playerY = 0 }
    when playerY > HEIGHT - playerSize { playerY = HEIGHT - playerSize }

    # Shooting
    lastShoot = lastShoot + 1
    when app.isKeyDown(KEYS.SPACE) and lastShoot > 10 {
        push(bullets, [playerX + playerSize / 2 - 2, playerY])
        lastShoot = 0
    }

    # Update Bullets
    newBullets = []
    get b in bullets {
        b[1] = b[1] - bulletSpeed
        when b[1] > -20 {
            push(newBullets, b)
        }
    }
    bullets = newBullets

    # Spawn Enemies
    enemySpawnTimer = enemySpawnTimer + 1
    when enemySpawnTimer > 30 {
        # Spawn an enemy at a random X
        ex = (clock() * 17 + score * 31) % (WIDTH - 40)
        espeed = 3 + (score / 10)
        push(enemies, [ex, -40, espeed])
        enemySpawnTimer = 0
    }

    # Update Enemies and Check Collisions
    newEnemies = []
    get e in enemies {
        e[1] = e[1] + e[2]
        
        # Check if enemy hit player
        # AABB collision
        when e[0] < playerX + playerSize and e[0] + 40 > playerX and e[1] < playerY + playerSize and e[1] + 40 > playerY {
            gameOver = true
        }
        
        # Check if enemy hit by bullet
        enemyAlive = true
        aliveBullets = []
        get b in bullets {
            hit = false
            when enemyAlive {
                when b[0] < e[0] + 40 and b[0] + 4 > e[0] and b[1] < e[1] + 40 and b[1] + 15 > e[1] {
                    # Hit!
                    score = score + 1
                    enemyAlive = false
                    hit = true
                }
            }
            when not hit {
                push(aliveBullets, b)
            }
        }
        bullets = aliveBullets
        
        when enemyAlive and e[1] < HEIGHT {
            push(newEnemies, e)
        }
    }
    enemies = newEnemies
})

# --- Graphics ---
app.onDrawCall(|| {
    # 1. Background (Dark Blue/Space)
    app.clear(10, 10, 30)
    
    # Stars (Simple static effect based on height)
    app.drawCircle(100, (clock() / 10) % HEIGHT, 2, 255, 255, 255)
    app.drawCircle(400, (clock() / 15) % HEIGHT, 2, 200, 200, 255)
    app.drawCircle(250, (clock() / 8) % HEIGHT, 3, 255, 255, 200)

    # 2. Draw Bullets (Yellow Lasers)
    get b in bullets {
        app.drawRect(b[0], b[1], 4, 15, 255, 255, 0)
    }

    # 3. Draw Enemies (Red Jets)
    get e in enemies {
        # Body
        app.drawRect(e[0] + 10, e[1], 20, 40, 200, 50, 50)
        # Wings
        app.drawRect(e[0], e[1] + 10, 40, 10, 150, 40, 40)
    }

    # 4. Draw Player (Blue Fighter Jet)
    # Body
    app.drawRect(playerX + playerSize/2 - 5, playerY, 10, playerSize, 50, 150, 255)
    # Wings
    app.drawRect(playerX, playerY + playerSize/2 + 5, playerSize, 10, 40, 100, 200)
    # Cockpit
    app.drawRect(playerX + playerSize/2 - 3, playerY + 5, 6, 10, 200, 255, 255)

    # 5. HUD
    app.drawText("SCORE: " + str(score), 10, 10, 20, 255, 255, 255)

    # 6. Game Over
    when gameOver {
        app.drawRect(WIDTH/2 - 150, HEIGHT/2 - 60, 300, 120, 100, 0, 0)
        app.drawText("GAME OVER!", WIDTH/2 - 90, HEIGHT/2 - 30, 30, 255, 255, 255)
        app.drawText("Press SPACE to Restart", WIDTH/2 - 110, HEIGHT/2 + 15, 20, 255, 255, 255)
    }
})

app.run()
