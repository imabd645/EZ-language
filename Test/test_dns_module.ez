# ============================================================================
# Test Suite: 'dns' Package -- DNS Resolution, Record Lookups & Security
# ============================================================================

use "dns" as dns

passed = 0
failed = 0

task check(label, actual, expected) {
    when str(actual) == str(expected) {
        out "  PASS: " + label
        passed = passed + 1
    } other {
        out "  FAIL: " + label
        out "    expected: " + str(expected)
        out "    got:      " + str(actual)
        failed = failed + 1
    }
}

task checkTruthy(label, val) {
    when val {
        out "  PASS: " + label
        passed = passed + 1
    } other {
        out "  FAIL: " + label + " (expected truthy, got " + str(val) + ")"
        failed = failed + 1
    }
}

out "=== DNS Package Test Suite ==="

# --- 1. Basic A and AAAA Record Queries ---
out "--- 1. IPv4 (A) & IPv6 (AAAA) Resolution ---"

aRecords = dns.resolve4("google.com")
checkTruthy("resolve4 google.com returns IPs", len(aRecords) > 0)
checkTruthy("resolve4 first IP contains dots", contains(aRecords[0], "."))

aaaaRecords = dns.resolve6("google.com")
checkTruthy("resolve6 google.com returns IPv6", len(aaaaRecords) > 0)
checkTruthy("resolve6 contains colons", contains(aaaaRecords[0], ":"))

directIp = dns.lookup("google.com")
checkTruthy("dns.lookup returns IP string", len(directIp) > 0)

# --- 2. MX (Mail Exchange) Resolution ---
out "--- 2. MX Resolution ---"

mxList = dns.resolveMx("google.com")
checkTruthy("resolveMx returns records", len(mxList) > 0)
checkTruthy("first MX has exchange host", len(mxList[0].exchange) > 0)
checkTruthy("first MX has priority number", mxList[0].priority >= 0)

# --- 3. TXT and SPF Records ---
out "--- 3. TXT & SPF Resolution ---"

txtList = dns.resolveTxt("google.com")
checkTruthy("resolveTxt returns records", len(txtList) > 0)

hasSpf = false
get txt in txtList {
    when startsWith(txt, "v=spf1") {
        hasSpf = true
        escape
    }
}
check("TXT contains SPF record", hasSpf, true)

# --- 4. Nameserver (NS) and SOA Resolution ---
out "--- 4. NS & SOA Resolution ---"

nsList = dns.resolveNs("google.com")
checkTruthy("resolveNs returns nameservers", len(nsList) > 0)
checkTruthy("NS record contains domain", contains(nsList[0], "google.com"))

soa = dns.resolveSoa("google.com")
checkTruthy("resolveSoa returns SOA record", soa != nil)
checkTruthy("SOA has primary NS", len(soa.primaryNs) > 0)
checkTruthy("SOA has admin email", len(soa.adminEmail) > 0)
checkTruthy("SOA has serial > 0", soa.serial > 0)

# --- 5. Reverse DNS (PTR) Lookup ---
out "--- 5. Reverse DNS (PTR) Lookup ---"

ptrList = dns.reverse("8.8.8.8")
checkTruthy("reverse 8.8.8.8 returns hostname", len(ptrList) > 0)
check("reverse 8.8.8.8 is dns.google", ptrList[0], "dns.google")

# --- 6. Security & Domain Validation Helpers ---
out "--- 6. Security (SPF, DMARC, Domain Config) ---"

spf = dns.getSpf("google.com")
check("SPF configured", spf["configured"], true)
check("SPF has policy ~all", spf["policy"], "~all")
checkTruthy("SPF has includes", len(spf["includes"]) > 0)

dmarc = dns.getDmarc("google.com")
check("DMARC configured", dmarc["configured"], true)
check("DMARC policy is reject", dmarc["policy"], "reject")

isDomainActive = dns.isConfigured("google.com")
check("isConfigured google.com", isDomainActive, true)

# --- 7. Custom Provider Resolvers ---
out "--- 7. Custom Provider Resolvers ---"

googleResolver = dns.Resolver({ "provider": "google" })
gAnswers = googleResolver.resolve4("google.com")
checkTruthy("Google DoH resolver works", len(gAnswers) > 0)

adguardResolver = dns.Resolver({ "provider": "adguard" })
agAnswers = adguardResolver.resolve4("google.com")
checkTruthy("AdGuard DoH resolver works", len(agAnswers) > 0)

aliResolver = dns.Resolver({ "provider": "alidns" })
aliAnswers = aliResolver.resolve4("google.com")
checkTruthy("AliDNS DoH resolver works", len(aliAnswers) > 0)

# --- 8. Worldwide DNS Propagation Check ---
out "--- 8. Multi-Provider Propagation ---"

propMap = dns.checkPropagation("google.com", "A")
checkTruthy("Propagation checked Cloudflare", has_key(propMap, "cloudflare"))
checkTruthy("Propagation checked Google", has_key(propMap, "google"))
checkTruthy("Propagation checked AdGuard", has_key(propMap, "adguard"))
checkTruthy("Cloudflare query succeeded", propMap["cloudflare"]["ok"])
checkTruthy("Google query succeeded", propMap["google"]["ok"])

out ""
out "=============================="
out "Results: " + str(passed) + " passed, " + str(failed) + " failed"
out "=============================="
