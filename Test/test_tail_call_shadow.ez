# Regression: `give f(...)` returned nil when f was NOT the enclosing function.
#
# compileGive emits TAIL_CALL whenever the callee is an identifier whose NAME
# matches the enclosing function's name. That match is only a guess -- the name
# can resolve to something else entirely. The VM checks the callee's real
# identity and only reuses the frame for a genuine self-call; otherwise it does
# an ordinary call and falls through.
#
# But the compiler emitted nothing after TAIL_CALL ("TAIL_CALL handles its own
# return"), so that fall-through landed on the function's implicit trailing
# LOAD_NIL + RETURN: the call ran, its result was thrown away, and the function
# returned nil with no error. Only tail position was affected:
#
#   static task urlDecode(s) {
#       b = urlDecode(s)     # fine -- ordinary CALL
#       give urlDecode(s)    # nil!  -- TAIL_CALL fell through to LOAD_NIL
#   }
#
# This silently broke C:/ezlib/web's WebUtils.urlDecode, which decoded every HTML
# form field and URL query parameter to nil.
#
# NOTE the shape that triggers it: a MODEL METHOD whose name matches a global it
# calls. A top-level `task urlDecode` would instead REPLACE the global, making
# `urlDecode(...)` inside it a real self-call (and, tail-optimised, an infinite
# loop) -- correct behaviour, and not this bug.

out "=== tail call to a shadowed global ==="

# The exact shape from ezlib/web: a static task tail-calling the builtin it
# shadows. The model member does not overwrite the global, so the inner call
# genuinely resolves to the builtin.
model WebUtils2 {
    static task urlDecode(strVal) {
        give urlDecode(str(strVal))
    }

    # Same, but NOT in tail position -- this path always worked.
    static task urlDecodeNonTail(strVal) {
        v = urlDecode(str(strVal))
        give v
    }
}

r1 = WebUtils2.urlDecode("hello%20world%21")
out "static task, tail position     : [" + str(r1) + "]"
when r1 == "hello world!" {
    out "PASS: tail call to a shadowed builtin returns its result"
} other {
    out "FAIL: expected 'hello world!', got [" + str(r1) + "]"
}

r2 = WebUtils2.urlDecodeNonTail("a%20b")
when r2 == "a b" {
    out "PASS: non-tail call still correct"
} other {
    out "FAIL: non-tail call broke, got [" + str(r2) + "]"
}

# An instance method shadowing a different builtin.
model Shouter {
    task upper(s) {
        give upper(s)
    }
}
sh = Shouter()
r3 = sh.upper("abc")
out "instance method shadowing upper: [" + str(r3) + "]"
when r3 == "ABC" {
    out "PASS: instance method tail-calling a shadowed builtin"
} other {
    out "FAIL: expected 'ABC', got [" + str(r3) + "]"
}

out "=== real TCO must still reuse frames ==="

# Genuine self tail call: must still be OPTIMISED, not merely correct. 100,000
# deep is ~200x the 512-frame cap, so this only passes if the frame is reused.
task countdown(n, acc) {
    when n == 0 { give acc }
    give countdown(n - 1, acc + 1)
}
r4 = countdown(100000, 0)
out "countdown(100000) = " + str(r4)
when r4 == 100000 {
    out "PASS: self tail call still reuses the frame (100,000 deep)"
} other {
    out "FAIL: TCO regressed, got " + str(r4)
}

# A tail call to an ordinary, differently-named EZ task must return its result.
task inner(x) { give x * 3 }
task outerCall(x) { give inner(x) }
when outerCall(5) == 15 {
    out "PASS: tail call to an ordinary EZ task returns its result"
} other {
    out "FAIL: expected 15, got " + str(outerCall(5))
}

out "=== Done ==="
