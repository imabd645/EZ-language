# ============================================================================
# lib/runtime/src/perf.ez -- Performance and Instruction Profiler
# ============================================================================

export model PerfController {
    init() {}

    task instructions() {
        give __vm_instruction_count()
    }

    task resetInstructions() {
        give __vm_reset_instruction_count()
    }

    task getMaxInstructions() {
        give __vm_get_max_instructions()
    }

    task setMaxInstructions(max) {
        give __vm_set_max_instructions(max)
    }

    task now() {
        give clock()
    }

    task time(fn) {
        start = clock()
        fn()
        elapsed = clock() - start
        give elapsed
    }
}
