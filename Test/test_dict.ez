// Test dictionary fragility
dict = {"a": 1, "b": 2}

out "1. Accessing existing key 'a':"
out dict["a"]

out "\n2. Accessing missing key 'c':"
val = dict["c"]
out "Value: " + str(val)

out "\n3. Accessing missing property .d:"
// Reading a missing property throws; catch it so the rest of the file still runs.
prop = nil
try { prop = dict.d } catch e { out "missing property .d correctly threw" }
out "Property: " + str(prop)

out "\n4. Testing dictionary builtins:"
// Dictionaries have no METHODS: `dict.get(...)` reads `get` as a property,
// finds no such key, and throws. The operations are free functions instead.
//
// This section used to call dict.get/has/keys/values and died here on line 18.
// Because an uncaught error still exited 0, the runner reported the whole file
// as passing and sections 5-6 never ran at all.
methodStyleWorks = false
try {
    dummy = dict.get("a", 0)
    methodStyleWorks = true
} catch e {
    out "method-style dict.get() is not supported -- use the builtins"
}
when methodStyleWorks { out "FAIL: dict.get() unexpectedly resolved" }

out "has_key(dict, 'a'): " + str(has_key(dict, "a"))
out "has_key(dict, 'c'): " + str(has_key(dict, "c"))
out "keys(dict): " + str(keys(dict))
out "values(dict): " + str(values(dict))
out "len(dict): " + str(len(dict))

out "\n5. Testing nil behavior:"
# This intentionally checks the RUNTIME error for nil arithmetic. Written as a
# literal `nil + 1` the static type checker rejects it at compile time, which
# stopped the whole file from running, so the nil is routed through a function
# to keep it opaque to the checker.
task opaqueNil() { give nil }
try {
    x = opaqueNil() + 1
    out "Success adding to nil (unexpected)"
} catch e {
    out "Caught expected error adding to nil: " + str(e)
}
