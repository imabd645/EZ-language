task enum_windows_callback(hwnd, lparam) {
    when  (hwnd != 0) {
        out "Found Window HWND: " + str(hwnd)
    }
    give 1
}

task main() {
    out "Loading user32.dll..."
     user32 = os_load_lib("user32.dll")
    when (user32 == 0) {
        out "Failed to load user32.dll"
        give
    }

    enum_windows = os_get_func(user32, "EnumWindows")
    when (enum_windows == 0) {
        out "Failed to find EnumWindows"
        give
    }
    
    out "Generating callback via libffi..."
    cb = os_ffi_create_callback(["ptr", "ptr"], "int", enum_windows_callback)
    
    out "Calling EnumWindows with callback address: " + str(cb)
    os_call(enum_windows, "int", cb, 0)
    
    out "Freeing callback..."
    os_ffi_free_callback(cb)
    out "Done!"
}

main()
