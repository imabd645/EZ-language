print("=== Testing SSL ===")
try {
    response = http_get("https://google.com")
} catch e {
}

print("Running insecure fetch...")
secure_opts = {}
secure_opts["insecure"] = true
secure_opts["method"] = "GET"
print("Calling await...")
fetch_res = await(fetch("https://google.com", secure_opts))
print("Await finished! Got response.")
print("Testing length...")
l = len(fetch_res)
print("Length: " + str(l))
