use "error_module.ez" as errMod

task level3() {
    out "Executing level 3... Calling imported module."
    
    # This call will crash inside the imported module, 
    # testing cross-file stack tracing!
    errMod.crash()
}

task level2() {
    out "Executing level 2..."
    level3()
}

task level1() {
    out "Executing level 1..."
    level2()
}

out "============================================="
out "      EZ Error Handling & Trace Test         "
out "============================================="

# Start the chain of function calls
level1()
