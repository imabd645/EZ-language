# Phase 8: defined integer arithmetic, defined shifts, and index type validation.
#
# EZ deliberately uses WRAPPING integer semantics -- the math library's LCG relies
# on large multiplications wrapping before a `%`, and hash/modulo chains depend on
# it too. The bug was not that it wrapped, but that it wrapped via signed-overflow
# UNDEFINED BEHAVIOUR, which the optimiser is free to assume never happens. The
# arithmetic now runs on the unsigned representation: same wrap, no UB.
#
# Also fixed: negating LLONG_MIN was UB; shift counts were unmasked (`1 << 64` is
# UB); and indexing with a non-number called asInteger() on it, which logged to
# stderr and threw bad_variant_access instead of a clean, catchable EZ error.

out "=== Defined Arithmetic & Index Validation ==="

MAXI = 9223372036854775807      # LLONG_MAX

# --- Overflow must wrap DETERMINISTICALLY (two's complement), not unpredictably ---
sum = MAXI + 1
out "MAXI + 1 = " + str(sum)
when sum < 0 {
    out "PASS: add overflow wraps deterministically (defined, not UB)"
} other {
    out "FAIL: unexpected add overflow result -> " + str(sum)
}

prod = MAXI * 2
out "MAXI * 2 = " + str(prod)
when prod == -2 {
    out "PASS: mul overflow wraps to the exact two's-complement value (-2)"
} other {
    out "FAIL: unexpected mul overflow result -> " + str(prod)
}

# NOTE: EZ has no power operator and the pow() builtin goes straight to
# std::pow (double math), so the VM's integer doPower() path is unreachable
# from source. Its wrap hardening is future-proofing and isn't asserted here.

# --- The wrapping the standard library depends on must still work ---
# An LCG step: large multiply that wraps, then % to come back into range.
seed = 123456789
seed = (seed * 6364136223846793005 + 1442695040888963407) % 2147483647
out "LCG step = " + str(seed)
when seed != 0 {
    out "PASS: LCG-style wrapping multiply still produces a value"
} other {
    out "FAIL: LCG-style wrapping multiply broke"
}

# --- Normal arithmetic must still be exact ---
when (2 + 3) == 5 and (10 - 4) == 6 and (6 * 7) == 42 and pow(2, 10) == 1024 {
    out "PASS: ordinary integer arithmetic still exact"
} other {
    out "FAIL: ordinary arithmetic broke"
}

# --- Shifts ---
when (1 << 10) == 1024 and (1024 >> 10) == 1 {
    out "PASS: normal shifts correct"
} other {
    out "FAIL: normal shifts wrong"
}

try {
    x = 1 << 64
    out "FAIL: shift of 64 was NOT rejected -> " + str(x)
} catch e {
    out "PASS: out-of-range shift rejected -> " + str(e)
}

try {
    y = 1 << -1
    out "FAIL: negative shift was NOT rejected -> " + str(y)
} catch e {
    out "PASS: negative shift rejected"
}

# --- Index type validation ---
# NOTE: the static type checker rejects a literal bad index at compile time, so
# these route the index through a function to reach the VM's runtime guard.
arr = [10, 20, 30]

task dyn(k) { give k }

try {
    v = arr[dyn("not a number")]
    out "FAIL: string index was NOT rejected -> " + str(v)
} catch e {
    out "PASS: string index rejected -> " + str(e)
}

try {
    v = arr[dyn(nil)]
    out "FAIL: nil index was NOT rejected -> " + str(v)
} catch e {
    out "PASS: nil index rejected"
}

try {
    arr[dyn(nil)] = 5
    out "FAIL: nil index assignment was NOT rejected"
} catch e {
    out "PASS: nil index assignment rejected"
}

# Valid indexing must still work.
when arr[0] == 10 and arr[2] == 30 {
    out "PASS: valid indexing still works"
} other {
    out "FAIL: valid indexing broke"
}

s = "hello"
when s[1] == "e" {
    out "PASS: string indexing still works"
} other {
    out "FAIL: string indexing broke"
}

out "=== Done ==="
