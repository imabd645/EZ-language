async task myAsyncFunc() {
    out "Starting async task..."
    
    // Simulate a network request or heavy I/O by yielding the task
    // The main event loop will continue running while this waits
    await waitAsync(1000)
    
    out "Async task resumed after 1 second!"
    give "Task Complete"
}

out "Before calling async function"
myAsyncFunc()
out "After calling async function (this should print BEFORE the task finishes)"
