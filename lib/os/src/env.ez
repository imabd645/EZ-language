// ============================================================================
// ezos / env.ez -- Cross-platform environment variable management
// ============================================================================

use "ffi.ez"
use "util.ez"
use "errors.ez"
use "fs"

export model OSEnv {
    task get(key) {
        when OSFFI.getEnv == nil { give nil }
        try {
            res = os_call(OSFFI.getEnv, "string", str(key))
            when res == "" and not self._isSetWindowsOrPosix(key) {
                give nil
            }
            give res
        } catch e {
            give nil
        }
    }

    task _isSetWindowsOrPosix(key) {
        when OSFFI.isWindows {
            when OSFFI.getEnvVar != nil {
                buf = os_alloc(2)
                needed = os_call(OSFFI.getEnvVar, "int", str(key), buf, 2)
                os_free(buf)
                give needed > 0
            }
        }
        give false
    }

    task has(key) {
        val = self.get(key)
        give not isNil(val) and val != ""
    }

    task require(key) {
        val = self.get(key)
        when isNil(val) or val == "" {
            raise_env("Required environment variable is not set", str(key))
        }
        give val
    }

    // Sets for the current process across Windows and POSIX
    task set(key, val) {
        key = str(key)
        val = str(val)

        when OSFFI.isWindows {
            when OSFFI.putEnv != nil { os_call(OSFFI.putEnv, "int", key, val) }
            when OSFFI.setEnvVar != nil { os_call(OSFFI.setEnvVar, "int", key, val) }
            give true
        } other {
            when OSFFI.setEnv != nil {
                os_call(OSFFI.setEnv, "int", key, val, 1)
                give true
            }
        }
        give false
    }

    task unset(key) {
        key = str(key)
        when OSFFI.isWindows {
            when OSFFI.putEnv != nil { os_call(OSFFI.putEnv, "int", key, "") }
            when OSFFI.setEnvVar != nil {
                ok = os_call(OSFFI.setEnvVar, "int", key, 0)
                give ok != 0
            }
            give true
        } other {
            when OSFFI.unsetEnv != nil {
                os_call(OSFFI.unsetEnv, "int", key)
                give true
            }
        }
        give false
    }

    // Expand %VAR% and ${VAR} and $VAR style references
    task expand(input) {
        src = str(input)
        when OSFFI.isWindows and OSFFI.expandEnvStrings != nil {
            buf = os_alloc(32768)
            needed = os_call(OSFFI.expandEnvStrings, "int", src, buf, 32768)
            when needed > 0 and needed <= 32768 {
                output = os_read_string_ptr(buf)
                os_free(buf)
                give output
            }
            os_free(buf)
        }

        // Pure EZ cross-platform variable expander for ${VAR} / $VAR / %VAR%
        res = src
        i = 0
        while i < len(res) {
            when substr(res, i, 2) == "${" {
                endIdx = indexOf(substr(res, i + 2, len(res) - i - 2), "}")
                when endIdx != -1 {
                    varName = substr(res, i + 2, endIdx)
                    varVal = self.get(varName)
                    when isNil(varVal) { varVal = "" }
                    res = substr(res, 0, i) + varVal + substr(res, i + 2 + endIdx + 1, len(res) - (i + 2 + endIdx + 1))
                    i = i + len(varVal) - 1
                }
            } other when substr(res, i, 1) == "%" {
                endIdx = indexOf(substr(res, i + 1, len(res) - i - 1), "%")
                when endIdx != -1 {
                    varName = substr(res, i + 1, endIdx)
                    varVal = self.get(varName)
                    when not isNil(varVal) {
                        res = substr(res, 0, i) + varVal + substr(res, i + 1 + endIdx + 1, len(res) - (i + 1 + endIdx + 1))
                        i = i + len(varVal) - 1
                    }
                }
            }
            i = i + 1
        }
        give res
    }

    // Snapshot all environment variables as a dictionary.
    task all() {
        output = {}
        when OSFFI.isWindows and OSFFI.getEnvStrings != nil {
            block = os_call(OSFFI.getEnvStrings, "ptr")
            when block != 0 and block != nil {
                ptr = block
                while true {
                    entry = os_read_string_ptr(ptr)
                    when entry == "" { escape }

                    eq = indexOf(entry, "=")
                    when eq != -1 and eq != 0 {
                        k = substr(entry, 0, eq)
                        v = substr(entry, eq + 1, len(entry) - eq - 1)
                        output[k] = v
                    }

                    ptr = ptr + len(entry) + 1
                }
                when OSFFI.freeEnvStrings != nil {
                    os_call(OSFFI.freeEnvStrings, "int", block)
                }
                give output
            }
        }

        // Fallback for common env keys
        commonKeys = ["PATH", "HOME", "USER", "USERPROFILE", "SHELL", "TERM", "LANG", "TEMP", "TMP", "PWD", "HOSTNAME"]
        get k in commonKeys {
            v = self.get(k)
            when not isNil(v) and v != "" {
                output[k] = v
            }
        }
        give output
    }

    // Load KEY=VALUE pairs from a .env file
    task load(path = ".env", options = nil) {
        when isNil(path) or path == "" { path = ".env" }
        opts = ensureDict(options)
        override = true
        when has_key(opts, "override") { override = opts["override"] }

        when not exists(path) { give false }

        content = readFile(path)
        lines = split(content, "\n")

        get line in lines {
            parsed = parseEnvLine(line)
            when not isNil(parsed) {
                k = parsed["key"]
                v = parsed["value"]
                when opts["expand"] == true {
                    v = self.expand(v)
                }
                when override or not self.has(k) {
                    self.set(k, v)
                }
            }
        }
        give true
    }
}
