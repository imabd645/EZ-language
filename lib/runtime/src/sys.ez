# ============================================================================
# lib/runtime/src/sys.ez -- System, Process and Environment Controller
# ============================================================================

export model SysController {
    init() {}

    task argv() {
        give argv
    }

    task pid() {
        give __process_pid()
    }

    task cwd() {
        give __process_cwd()
    }

    task exit(code) {
        when code == nil { code = 0 }
        exit(code)
    }
}
