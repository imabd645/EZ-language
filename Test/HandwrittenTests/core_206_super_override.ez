// Test deep inheritance and super calls
model Base {
    init() {
        self.val = 1
    }
    task getVal() {
        give self.val
    }
    task name() {
        give "Base"
    }
}

model Mid extends Base {
    init() {
        super()
        self.val = self.val + 10
    }
    task name() {
        give "Mid > " + super.name()
    }
}

model Child extends Mid {
    init() {
        super()
        self.val = self.val + 100
    }
    task name() {
        give "Child > " + super.name()
    }
}

c = new Child()
assert(c.getVal() == 111, "Child val should be 111")
// assert(c.name() == "Child > Mid > Base", "Super method chaining should work") // Wait, EZ might not have super.name()!
