# An exception inside an FFI callback that runs on a NON-main thread must not
# crash the VM.
#
# The callback fires on a worker thread (here: EnumWindows invoked from a spawned
# thread), so the FFI dispatcher marshals it onto the main thread's event loop.
# When the callback body hit a RUNTIME error (not a `throw`), the VM used to
# unwind a C++ exception straight out of run()'s computed-goto dispatch. Under the
# event loop that corrupted the C++ unwinder and the process died with a hard
# access violation -- even though the error was caught inside the callback.
#
# This is exactly the shape of an ezweb request handler: the C accelerator calls
# the EZ handler through an FFI callback on a connection thread, and a handler
# that indexed nil took the whole server down.
#
# The fix: run() never unwinds a C++ exception out of its dispatch. It hands the
# exception back via pendingException and returns; callFunction re-raises it from
# ordinary-function context, which unwinds safely.

passes = 0
fails = 0
task check(name, actual, expected) {
    when str(actual) == str(expected) {
        passes = passes + 1
        out "  [PASS] " + name
    } other {
        fails = fails + 1
        out "  [FAIL] " + name + "  expected [" + str(expected) + "] got [" + str(actual) + "]"
    }
}

out "=== exception inside an FFI callback on a worker thread ==="

user32 = os_load_lib("user32.dll")
enumWindows = os_get_func(user32, "EnumWindows")

# --- 1. runtime error caught inside the callback ----------------------------
state = {"ran": false, "caught": false}
cb1 = |hwnd, lparam| {
    state["ran"] = true
    try {
        d = nil
        x = d["k"]            # runtime error: Cannot index nil
    } catch (e) {
        state["caught"] = true
    }
    give 0                    # stop after the first window
}
ref1 = os_ffi_create_callback(["ptr", "ptr"], "int", cb1)

task worker1() {
    os_call(enumWindows, "int", ref1, 0)
    give "worker1 done"
}
r1 = await spawn(worker1)
check("worker survived a caught runtime error", r1, "worker1 done")
check("the callback actually ran", state["ran"], true)
check("the error was caught inside the callback", state["caught"], true)

# --- 2. `throw` caught inside the callback ----------------------------------
state2 = {"caught": false}
cb2 = |hwnd, lparam| {
    try { throw "boom" } catch (e) { state2["caught"] = true }
    give 0
}
ref2 = os_ffi_create_callback(["ptr", "ptr"], "int", cb2)
task worker2() { os_call(enumWindows, "int", ref2, 0)  give "worker2 done" }
# NB: `await` is a prefix operator; do not nest it inline as a call argument
# (`f(await spawn(x))` mis-parses). Await into a variable first.
f2 = spawn(worker2)
r2 = await f2
check("worker survived a caught throw", r2, "worker2 done")
check("the throw was caught", state2["caught"], true)

# --- 3. the VM is still healthy afterward -----------------------------------
task compute(a, b) { give a * b + 1 }
check("plain calls still work after all that", compute(6, 7), 43)

model Point { init(x, y) { self.x = x  self.y = y } task sum() { give self.x + self.y } }
check("construction still works", Point(3, 4).sum(), 7)

# --- 4. many worker callbacks with errors, in a row -------------------------
i = 0
while i < 10 {
    s = {"c": false}
    cbN = |hwnd, lparam| {
        try { z = nil  w = z["x"] } catch (e) { s["c"] = true }
        give 0
    }
    refN = os_ffi_create_callback(["ptr", "ptr"], "int", cbN)
    task workerN() { os_call(enumWindows, "int", refN, 0)  give "ok" }
    fN = spawn(workerN)
    rN = await fN
    i = i + 1
}
check("10 worker callbacks with errors survived", compute(2, 3), 7)

out ""
out "========================================"
out " passed: " + str(passes) + "   failed: " + str(fails)
out "========================================"
