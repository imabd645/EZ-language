# ============================================================================
# Test: Property access, keyword properties, and chaining
# ============================================================================

out "=== Testing Property Access & Chaining ==="

model Person {
    init(name, age) {
        self.name = name
        self.age = age
        self.init = "init_val"
        self.true = "true_val"
    }
    task getGreeting() {
        give "Hello, " + self.name
    }
}

p = Person("Alice", 30)

# 1. Normal property access
when p.name == "Alice" and p.age == 30 {
    out "PASS: Normal property access works"
} other {
    out "FAIL: Normal property access failed"
}

# 2. Keyword property names
when p.init == "init_val" and p.true == "true_val" {
    out "PASS: Keyword property names work"
} other {
    out "FAIL: Keyword property names failed"
}

# 3. Optional chaining on instance
when p?.name == "Alice" {
    out "PASS: Optional chaining on valid instance works"
} other {
    out "FAIL: Optional chaining on valid instance failed"
}

# 4. Optional chaining on nil
emptyObj = nil
when emptyObj?.name == nil {
    out "PASS: Optional chaining on nil safely evaluates to nil"
} other {
    out "FAIL: Optional chaining on nil failed"
}

# 5. Multi-line property and method chaining
greeting = p
    .getGreeting()
when greeting == "Hello, Alice" {
    out "PASS: Multi-line chaining works"
} other {
    out "FAIL: Multi-line chaining failed"
}

out "=== Test Complete ==="
