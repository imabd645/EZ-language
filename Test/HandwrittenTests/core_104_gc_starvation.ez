// ============================================================================
// GC Starvation Test (Tight Loop Daemon)
// ============================================================================
out "=== Starting GC Starvation Test ==="

task tightLoop() {
    // This task does absolutely nothing but spin, never explicitly yielding or waiting
    while true {
        x = 1 + 1
    }
}

// Spawn the tight loop as a daemon so it doesn't prevent exit
fut = spawn(tightLoop, {"daemon": true})

// Now generate a ton of garbage in the main thread
// If the tight loop prevents GC (because it never reaches a safepoint),
// memory will either explode or the manual GC trigger will hang forever!
out "Generating garbage..."
repeat i = 1 to 50000 {
    garbage = [1, 2, 3, 4, 5]
    garbage2 = {"a": 1, "b": 2}
}

out "Triggering manual GC..."
// wait, is there a gc_collect builtin? I think the prompt showed gcStressor relying on automatic GC or wait()
// Let's just finish the script. If it finishes, GC didn't deadlock!

out "PASS: Survived massive allocation while daemon spun!"
out "=== GC Starvation Test Finished ==="
