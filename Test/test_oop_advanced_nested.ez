# ============================================================================
# Advanced OOP, Multi-Level Inheritance, Operator Overloading & Polymorphism
# ============================================================================

passed = 0
failed = 0

task check(label, actual, expected) {
    when str(actual) == str(expected) {
        out "  PASS: " + label
        passed = passed + 1
    } other {
        out "  FAIL: " + label
        out "    expected: " + str(expected)
        out "    got:      " + str(actual)
        failed = failed + 1
    }
}

# --- 1. Deep Inheritance Chain (4 Levels) with Super Chaining ---
out "--- 1. Deep Inheritance Chain (4 Levels) ---"
model Entity {
    init(name) {
        self.name = name
    }
    task describe() {
        give "Entity(" + self.name + ")"
    }
}

model LivingEntity extends Entity {
    init(name, hp) {
        super.init(name)
        self.hp = hp
    }
    task describe() {
        give "Living[" + str(self.hp) + "] -> " + super.describe()
    }
}

model Animal extends LivingEntity {
    init(name, hp, species) {
        super.init(name, hp)
        self.species = species
    }
    task describe() {
        give "Animal(" + self.species + ") -> " + super.describe()
    }
}

model Dog extends Animal {
    init(name, hp, breed) {
        super.init(name, hp, "Canine")
        self.breed = breed
    }
    task describe() {
        give "Dog[" + self.breed + "] -> " + super.describe()
    }
}

d = new Dog("Buddy", 100, "Golden")
desc = d.describe()
check("4-level super describe", desc, "Dog[Golden] -> Animal(Canine) -> Living[100] -> Entity(Buddy)")

# --- 2. Polymorphic Dynamic Dispatch over Heterogeneous Array ---
out "--- 2. Polymorphic Dynamic Dispatch ---"
model Shape {
    task area() { give 0 }
    task name() { give "Shape" }
}

model Rectangle extends Shape {
    init(w, h) {
        self.w = w
        self.h = h
    }
    task area() { give self.w * self.h }
    task name() { give "Rectangle" }
}

model Circle extends Shape {
    init(r) {
        self.r = r
    }
    task area() { give 3 * self.r * self.r } # approximated pi = 3
    task name() { give "Circle" }
}

shapes = [new Rectangle(4, 5), new Circle(3), new Rectangle(2, 8)]
totalArea = 0
namesLog = ""
get s in shapes {
    totalArea = totalArea + s.area()
    namesLog = namesLog + s.name() + ":" + str(s.area()) + " "
}
check("polymorphic area sum", totalArea, 63)
check("polymorphic names log", namesLog, "Rectangle:20 Circle:27 Rectangle:16 ")

# --- 3. Operator Overloading Pipeline (+, -, *, ==) ---
out "--- 3. Operator Overloading Pipeline ---"
model Vec2D {
    init(x, y) {
        self.x = x
        self.y = y
    }
    task +(rhs) {
        give new Vec2D(self.x + rhs.x, self.y + rhs.y)
    }
    task -(rhs) {
        give new Vec2D(self.x - rhs.x, self.y - rhs.y)
    }
    task *(scalar) {
        give new Vec2D(self.x * scalar, self.y * scalar)
    }
    task ==(rhs) {
        when rhs == nil { give false }
        give self.x == rhs.x and self.y == rhs.y
    }
    task repr() {
        give "(" + str(self.x) + "," + str(self.y) + ")"
    }
}

v1 = new Vec2D(1, 2)
v2 = new Vec2D(3, 4)
v3 = new Vec2D(5, 6)

# (v1 + v2) * 2 - v3 = (1+3, 2+4)*2 - (5,6) = (8, 12) - (5,6) = (3, 6)
resVec = (v1 + v2) * 2 - v3
check("vector math pipeline", resVec.repr(), "(3,6)")

vExpected = new Vec2D(3, 6)
check("vector equality overload true", resVec == vExpected, true)
check("vector equality overload false", resVec == v1, false)

# --- 4. Methods Returning Closures Capturing Self ---
out "--- 4. Closures Capturing Self ---"
model Counter {
    init(start) {
        self.count = start
    }
    task makeIncrementer(amt) {
        give || {
            self.count = self.count + amt
            give self.count
        }
    }
}

c1 = new Counter(10)
c2 = new Counter(100)
inc1 = c1.makeIncrementer(5)
inc2 = c2.makeIncrementer(10)

resLog = ""
resLog = resLog + str(inc1()) + " " # 15
resLog = resLog + str(inc1()) + " " # 20
resLog = resLog + str(inc2()) + " " # 110
resLog = resLog + str(inc1()) + " " # 25
resLog = resLog + str(inc2()) + " " # 120

check("self capturing closures", resLog, "15 20 110 25 120 ")
check("counter 1 final state", c1.count, 25)
check("counter 2 final state", c2.count, 120)

# --- 5. Static Methods and Model Factories ---
out "--- 5. Static Methods and Model Factories ---"
model Point {
    init(x, y) {
        self.x = x
        self.y = y
    }
    static task origin() {
        give new Point(0, 0)
    }
    static task unitX() {
        give new Point(1, 0)
    }
    static task unitY() {
        give new Point(0, 1)
    }
    task toString() {
        give str(self.x) + ":" + str(self.y)
    }
}

p0 = Point.origin()
px = Point.unitX()
py = Point.unitY()
check("static factory origin", p0.toString(), "0:0")
check("static factory unitX", px.toString(), "1:0")
check("static factory unitY", py.toString(), "0:1")

# --- 6. Type Pattern Matching with Models ---
out "--- 6. Type Pattern Matching with Models ---"
task classifyEntity(obj) {
    match obj {
        Dog => { give "IsDog" }
        Animal => { give "IsAnimal" }
        LivingEntity => { give "IsLiving" }
        Shape => { give "IsShape" }
        other => { give "Unknown" }
    }
}

check("match Dog", classifyEntity(new Dog("Rex", 50, "Husky")), "IsDog")
check("match Animal", classifyEntity(new Animal("Leo", 80, "Lion")), "IsAnimal")
check("match LivingEntity", classifyEntity(new LivingEntity("Tree", 200)), "IsLiving")
check("match Shape", classifyEntity(new Shape()), "IsShape")
check("match Unknown", classifyEntity("just a string"), "Unknown")

# --- 7. Multiple Method Calls Inside Exception Handlers and Loops ---
out "--- 7. Models in Loops with Exceptions ---"
model BankAccount {
    init(balance) {
        self.balance = balance
        self.txCount = 0
    }
    task withdraw(amount) {
        when amount > self.balance {
            throw "OverdraftError"
        }
        self.balance = self.balance - amount
        self.txCount = self.txCount + 1
        give self.balance
    }
}

acc = new BankAccount(100)
withdrawAmounts = [30, 40, 50, 20]
accLog = ""

get amt in withdrawAmounts {
    try {
        rem = acc.withdraw(amt)
        accLog = accLog + "ok:" + str(rem) + " "
    } catch e {
        accLog = accLog + "fail:" + str(e) + " "
    } finally {
        accLog = accLog + "txs:" + str(acc.txCount) + " "
    }
}

check("bank account balance", acc.balance, 10)
check("bank account txCount", acc.txCount, 3)
check("bank account transactions log", accLog, "ok:70 txs:1 ok:30 txs:2 fail:OverdraftError txs:2 ok:10 txs:3 ")

out ""
out "=============================="
out "Results: " + str(passed) + " passed, " + str(failed) + " failed"
out "=============================="
