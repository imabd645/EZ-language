# ============================================================================
# lib/sandbox/src/sandbox.ez -- Sandbox Controller Implementation
# ============================================================================

use "runtime" as rt
use "guard.ez"

export model Sandbox {
    init(options = {}) {
        self.allowFS = false
        self.allowNet = false
        self.allowProcess = false
        self.allowFFI = false
        self.maxRecursionDepth = 50
        self.maxInstructions = 100000
        self.injectedGlobals = {}

        when has_key(options, "allowFS") { self.allowFS = options["allowFS"] }
        when has_key(options, "allowNet") { self.allowNet = options["allowNet"] }
        when has_key(options, "allowProcess") { self.allowProcess = options["allowProcess"] }
        when has_key(options, "allowFFI") { self.allowFFI = options["allowFFI"] }
        when has_key(options, "maxRecursionDepth") { self.maxRecursionDepth = options["maxRecursionDepth"] }
        when has_key(options, "maxInstructions") { self.maxInstructions = options["maxInstructions"] }
    }

    task inject(name, value) {
        self.injectedGlobals[name] = value
        give self
    }

    task injectAll(dict) {
        get k in keys(dict) {
            self.injectedGlobals[k] = dict[k]
        }
        give self
    }

    task eval(code) {
        prevDepth = rt.vm.getMaxRecursionDepth()
        prevMaxInst = rt.perf.getMaxInstructions()

        # Build list of builtins to block
        blockedList = getBlockedBuiltins({
            "allowFS": self.allowFS,
            "allowNet": self.allowNet,
            "allowProcess": self.allowProcess,
            "allowFFI": self.allowFFI
        })

        # Save original builtins & inject temporary blocking closures
        origBuiltins = {}
        get b in blockedList {
            origVal = __vm_get_global(b)
            when origVal != nil {
                origBuiltins[b] = origVal
                __vm_set_global(b, |...args| {
                    throw Exception("SecurityError: '" + b + "' is disabled in this sandbox")
                })
            }
        }

        # Save and inject custom variables
        origInjected = {}
        get k in keys(self.injectedGlobals) {
            origInjected[k] = __vm_get_global(k)
            __vm_set_global(k, self.injectedGlobals[k])
        }

        # Set VM constraints relative to current frame depth immediately before execution
        currDepth = rt.vm.currentDepth()
        rt.vm.setMaxRecursionDepth(currDepth + self.maxRecursionDepth)
        rt.perf.setMaxInstructions(self.maxInstructions)

        try {
            res = eval(code)
            give res
        } finally {
            # Restore VM bounds
            rt.perf.setMaxInstructions(prevMaxInst)
            rt.vm.setMaxRecursionDepth(prevDepth)

            # Restore blocked builtins
            get b in keys(origBuiltins) {
                __vm_set_global(b, origBuiltins[b])
            }

            # Restore / cleanup injected globals
            get k in keys(self.injectedGlobals) {
                prev = origInjected[k]
                when prev != nil {
                    __vm_set_global(k, prev)
                } other {
                    __vm_set_global(k, nil)
                }
            }
        }
    }
}

export task create(options = {}) {
    give Sandbox(options)
}
