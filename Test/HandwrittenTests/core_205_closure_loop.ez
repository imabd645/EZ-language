// Test loop closure upvalues
task makeAdder(x) {
    give |y| { give x + y }
}

add5 = makeAdder(5)
assert(add5(10) == 15, "makeAdder(5)(10) should be 15")

// Loop closure test
j = 0
mutatingFuncs = []
while j < 3 {
    localJ = j
    push(mutatingFuncs, || { give localJ })
    j = j + 1
}

assert(mutatingFuncs[0]() == 0, "Closure should capture localJ as 0")
assert(mutatingFuncs[1]() == 1, "Closure should capture localJ as 1")
assert(mutatingFuncs[2]() == 2, "Closure should capture localJ as 2")
