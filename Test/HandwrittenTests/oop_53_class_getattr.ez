// A STATIC __getattr__(cls, name) answers class-level access for names the
// class never declared -- how an ORM exposes Model.column for query building
// without needing an instance.
model User {
    static __getattr__ = |cls, name| {
        give "col<" + cls.name + "." + name + ">"
    }
    static tableName = "users"
    init() { self.id = 0 }
}

print(User.tableName)      // real static wins
print(User.age)            // hook
print(User.email)          // hook

// Classes without the static hook still error.
model Bare { init() { self.x = 1 } }
try { print(Bare.nothing)  print("FAIL") } catch (e) { print("bare class still errors") }
