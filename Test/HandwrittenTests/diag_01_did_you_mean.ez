myVariable = 42

try {
    out myVariable // Should suggest myVariable
    out "Should have thrown error"
} catch e {
    out "Caught: " + str(e)
}

myDictionary = {"name": "EZ"}

try {
    out myDictionary.name // Should suggest name
    out "Should have thrown error"
} catch e {
    out "Caught: " + str(e)
}

exit(0)