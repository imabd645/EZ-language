try {
    throw "simple error message"
} catch (e) {
    out "Simple catch got: " + e
}

try {
    repeat i = 0 to 1000 step 0 {
        out i
    }
} catch (e) {
    out "Caught expected error: " + e
}

# Destructuring assignment test
a, b = [10, 20]
out "a = " + a
out "b = " + b

