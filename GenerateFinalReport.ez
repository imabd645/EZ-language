# Final Report Generator for CS104
use "lib/pdf.ez"
use "lib/db_ops.ez"

db = db_open("ProjectADb26.db")

out "Generating Final FYP Project Report..."
rep = PDF("UET_FYP_FINAL_REPORT.pdf")
rep.addPage().header("UET LAHORE - FYP ADVISORY BOARD")

rep.text(50, 750, "Final Year Project List - Spring 2026 Season", 16)
rep.tableHeader(700, ["ID", "Project Title", "Advisor Status"])

projs = getProjects(db)
y = 670
get p in projs {
    rep.tableRow(y, [p["Id"], p["Title"], "ACTIVE"])
    y = y - 25
}

rep.line(50, 100, 550, 100)
rep.text(50, 80, "This document is officially generated by the EZ FYP Management System.", 8)

rep.save()
db_close(db)
out "Final Report saved to: UET_FYP_FINAL_REPORT.pdf"
