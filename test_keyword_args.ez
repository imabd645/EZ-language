// test_keyword_args.ez

task calculateArea(width: number, height: number, depth: number = 1) -> number {
    give width * height * depth
}

task main() {
    print("Testing Keyword Arguments:")
    
    // Standard positional
    let a1 = calculateArea(10, 5, 2)
    print("Standard: ")
    print(a1)
    
    // Fully keyword, out of order
    let a2 = calculateArea(height=5, depth=2, width=10)
    print("Fully Keyword: ")
    print(a2)
    
    // Mixed positional and keyword
    let a3 = calculateArea(10, depth=2, height=5)
    print("Mixed: ")
    print(a3)
    
    // Default value with keyword
    let a4 = calculateArea(height=5, width=10)
    print("Default with Keyword: ")
    print(a4)
}

main()
