# numpy.ez - FFI-based high-performance math library for EZ

os = import("os")

# Load backend DLL
_dll = os_load_lib("lib/ezmath.dll")
if _dll == 0 {
    panic("Failed to load lib/ezmath.dll. Please compile lib/src/ezmath.cpp into lib/ezmath.dll.")
}

_add = os_get_func(_dll, "ezmath_add_f32")
_sub = os_get_func(_dll, "ezmath_sub_f32")
_mul = os_get_func(_dll, "ezmath_mul_f32")
_div = os_get_func(_dll, "ezmath_div_f32")
_dot = os_get_func(_dll, "ezmath_dot_f32")
_sum = os_get_func(_dll, "ezmath_sum_f32")
_fill = os_get_func(_dll, "ezmath_fill_f32")
_matmul = os_get_func(_dll, "ezmath_matmul_f32")

class Tensor {
    init(shape) {
        if type(shape) != "Array" {
            shape = [shape]
        }
        this.shape = shape
        this.size = 1
        for s in shape {
            this.size = this.size * s
        }
        # 4 bytes per float32
        this.buf = buffer(this.size * 4)
    }

    # Internal initializer
    static _create(shape, buf) {
        t = Tensor(shape)
        t.buf = buf
        give t
    }

    # Factory methods
    static zeros(shape) {
        t = Tensor(shape)
        os_call(_fill, "void", t.buf, 0.0, t.size)
        give t
    }

    static ones(shape) {
        t = Tensor(shape)
        os_call(_fill, "void", t.buf, 1.0, t.size)
        give t
    }

    static from_list(lst) {
        size = len(lst)
        t = Tensor(size)
        addr = os_buffer_addr(t.buf)
        i = 0
        while i < size {
            os_write_float32(addr, i * 4, lst[i])
            i = i + 1
        }
        give t
    }

    # Get/Set
    get(index) {
        addr = os_buffer_addr(this.buf)
        give os_read_float32(addr, index * 4)
    }

    set(index, val) {
        addr = os_buffer_addr(this.buf)
        os_write_float32(addr, index * 4, val)
    }

    # Operations
    add(other) {
        if this.size != other.size { panic("Tensor size mismatch in add") }
        res = Tensor(this.shape)
        os_call(_add, "void", this.buf, other.buf, res.buf, this.size)
        give res
    }

    sub(other) {
        if this.size != other.size { panic("Tensor size mismatch in sub") }
        res = Tensor(this.shape)
        os_call(_sub, "void", this.buf, other.buf, res.buf, this.size)
        give res
    }

    mul(other) {
        if this.size != other.size { panic("Tensor size mismatch in mul") }
        res = Tensor(this.shape)
        os_call(_mul, "void", this.buf, other.buf, res.buf, this.size)
        give res
    }

    div(other) {
        if this.size != other.size { panic("Tensor size mismatch in div") }
        res = Tensor(this.shape)
        os_call(_div, "void", this.buf, other.buf, res.buf, this.size)
        give res
    }

    dot(other) {
        if this.size != other.size { panic("Tensor size mismatch in dot") }
        give os_call(_dot, "float", this.buf, other.buf, this.size)
    }

    sum() {
        give os_call(_sum, "float", this.buf, this.size)
    }

    # Matrix multiplication (2D only)
    matmul(other) {
        if len(this.shape) != 2 or len(other.shape) != 2 {
            panic("matmul requires 2D tensors")
        }
        if this.shape[1] != other.shape[0] {
            panic("matmul dimension mismatch")
        }
        m = this.shape[0]
        n = other.shape[1]
        k = this.shape[1]
        
        res = Tensor([m, n])
        os_call(_matmul, "void", this.buf, other.buf, res.buf, m, n, k)
        give res
    }

    to_list() {
        lst = []
        addr = os_buffer_addr(this.buf)
        i = 0
        while i < this.size {
            lst.push(os_read_float32(addr, i * 4))
            i = i + 1
        }
        give lst
    }

    __str__() {
        give "Tensor(" + str(this.shape) + ", " + str(this.to_list()) + ")"
    }
}
