# ============================================================================
# Test Suite: Safe Mode & Capability-Based Security (--safe)
# ============================================================================

passed = 0
failed = 0

task check(label, actual, expected) {
    when str(actual) == str(expected) {
        out "  PASS: " + label
        passed = passed + 1
    } other {
        out "  FAIL: " + label
        out "    expected: " + str(expected)
        out "    got:      " + str(actual)
        failed = failed + 1
    }
}

task checkThrowsPermissionError(label, fn) {
    threw = false
    try {
        fn()
    } catch e {
        threw = true
        out "    [Caught expected PermissionError]: " + str(e)
    }
    check(label, threw, true)
}

out "=== Capability Security Test Suite (--safe) ==="

# --- 1. Process Execution Restriction ---
out "--- 1. Process Execution ---"
checkThrowsPermissionError("system() execution is blocked", || {
    system("echo 'should not run'")
})

# --- 2. Native FFI Restriction ---
out "--- 2. Native FFI ---"
checkThrowsPermissionError("os_load_lib() is blocked", || {
    os_load_lib("Kernel32.dll")
})

# --- 3. Network Access Restriction ---
out "--- 3. Network Access ---"
checkThrowsPermissionError("http_get() is blocked", || {
    http_get("https://example.com")
})

# --- 4. File Write Restriction ---
out "--- 4. File Write ---"
checkThrowsPermissionError("writeFile() is blocked", || {
    writeFile("test_blocked_write.tmp", "malicious payload")
})

# --- 5. File Read (outside permitted directory) ---
out "--- 5. External File Read ---"
checkThrowsPermissionError("readFile() on Windows system directory is blocked", || {
    readFile("C:\\Windows\\win.ini")
})

out ""
out "=============================="
out "Results: " + str(passed) + " passed, " + str(failed) + " failed"
out "=============================="
