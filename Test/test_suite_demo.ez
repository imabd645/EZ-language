# ============================================================================
# EZ Test Suite Demo
# Demonstrates use of testing.ez
# ============================================================================

use "testing"

describe("EZ Core Features", || {
    
    it("should handle basic arithmetic", || {
        assertEquals(2 + 2, 4, "Addition failed")
        assertEquals(10 * 10, 100, "Multiplication failed")
    })

    it("should handle string interpolation", || {
        name = "EZ"
        result = `Hello {name}`
        assertEquals(result, "Hello EZ", "Interpolation failed")
    })

    it("should fail on incorrect assertions", || {
        # This is expected to fail in this demo
        assertEquals(1 + 1, 3, "Intentional failure")
    })

})

testSummary()
