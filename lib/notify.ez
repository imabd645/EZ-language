# ============================================================================
# Notify - Cross-Platform Desktop Notification Library for EZ
# Supports Windows (Shell32 FFI), macOS (osascript), and Linux (notify-send)
# ============================================================================

model notify {
    # Icon Types
    static NONE = 0
    static INFO = 1
    static WARNING = 2
    static ERROR = 3

    static task _write32(buf, offset, val) {
        os_write_byte(buf, offset, val & 255)
        os_write_byte(buf, offset + 1, (val >> 8) & 255)
        os_write_byte(buf, offset + 2, (val >> 16) & 255)
        os_write_byte(buf, offset + 3, (val >> 24) & 255)
    }

    static task show(title, message) {
        notify.showWithIcon(title, message, notify.INFO)
    }

    static task showWithIcon(title, message, iconType) {
        currentOs = os()
        when currentOs == "windows" {
            try {
                k32 = os_load_lib("Kernel32.dll")
                u32 = os_load_lib("User32.dll")
                s32 = os_load_lib("Shell32.dll")
                getConsoleWindow = os_get_func(k32, "GetConsoleWindow")
                loadIcon = os_get_func(u32, "LoadIconA")
                shellNotifyIcon = os_get_func(s32, "Shell_NotifyIconA")

                # NOTIFYICONDATAA struct (64-bit alignment)
                size = 508
                buf = os_alloc(size)
                repeat i = 0 to size {
                    os_write_byte(buf, i, 0)
                }

                hWnd = os_call(getConsoleWindow, "ptr")
                hIcon = os_call(loadIcon, "ptr", 0, 32512) # IDI_APPLICATION = 32512

                # Fill struct
                notify._write32(buf, 0, size)        # cbSize
                os_write_uint64(buf, 8, hWnd)        # hWnd
                notify._write32(buf, 16, 1234)       # uID
                notify._write32(buf, 20, 22)         # uFlags (NIF_ICON | NIF_TIP | NIF_INFO = 2+4+16=22)
                os_write_uint64(buf, 32, hIcon)      # hIcon
                os_write_string(buf, 40, str(title))
                os_write_string(buf, 176, str(message))
                os_write_string(buf, 440, str(title))
                notify._write32(buf, 504, iconType)  # dwInfoFlags

                os_call(shellNotifyIcon, "int", 0, buf)
                os_call(shellNotifyIcon, "int", 1, buf)
                os_free(buf)
                give nil
            } catch e {
                give nil
            }
        } when currentOs == "macos" {
            cmd = "osascript -e 'display notification \"" + str(message) + "\" with title \"" + str(title) + "\"'"
            system(cmd)
            give nil
        } when currentOs == "linux" {
            urgency = "normal"
            when iconType == notify.WARNING { urgency = "normal" }
            when iconType == notify.ERROR   { urgency = "critical" }
            cmd = "notify-send -u " + urgency + " \"" + str(title) + "\" \"" + str(message) + "\" 2>/dev/null || true"
            system(cmd)
            give nil
        } other {
            out "[" + str(title) + "] " + str(message)
            give nil
        }
    }
}
