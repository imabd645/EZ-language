// ============================================================================
// Test Cross-Platform System & OS Library
// ============================================================================

use "os" as *

passed = 0
failed = 0

task check(name, cond) {
    when cond {
        passed = passed + 1
        out "[PASS] " + name
    } other {
        failed = failed + 1
        out "[FAIL] " + name
    }
}

out "=== Cross-Platform OS Smoke Tests ==="

out "Platform (builtin): " + os()
check("os() is non-empty", len(os()) > 0)

out "Platform: " + getPlatform()
check("getPlatform is non-empty", len(getPlatform()) > 0)
check("isWindows or isPosix", isWindows() or isPosix())

out "CWD: " + cwd()
check("cwd is non-empty", len(cwd()) > 0)

out "CPU Cores: " + str(cpuCores())
check("cpuCores >= 1", cpuCores() >= 1)

out "Arch: " + arch()
check("arch is known", arch() != "unknown")

out "Total Memory: " + str(totalMemory())
check("totalMemory > 0", totalMemory() > 0)

out "PID: " + str(pid())
check("pid > 0", pid() > 0)

out "User Name: " + userName()
check("userName non-empty", len(userName()) > 0)

out "Host Name: " + hostname()
check("hostname non-empty", len(hostname()) > 0)

out "Home Dir: " + homedir()
check("homedir non-empty", len(homedir()) > 0)

out "Temp Dir: " + tmpdir()
check("tmpdir non-empty", len(tmpdir()) > 0)

// Path tests
out "Path Sep: " + path.sep()
check("path join", len(path.join("a", "b")) > 0)
check("path extname", path.extname("archive.tar.gz") == ".gz")
check("path stem", path.stem("test.ez") == "test")

// Environment tests
env.set("EZ_TEST_CROSS_VAR", "antigravity_123")
check("env set/get", env.get("EZ_TEST_CROSS_VAR") == "antigravity_123")
check("env has", env.has("EZ_TEST_CROSS_VAR") == true)
env.unset("EZ_TEST_CROSS_VAR")
check("env unset", env.has("EZ_TEST_CROSS_VAR") == false)

// Process tests
runRes = process.run("echo ezos_test", { "check": false })
check("process run", runRes["ok"] and indexOf(runRes["stdout"], "ezos_test") != -1)

// Sys model tests
check("sys.platform matches", sys.platform() == getPlatform())
check("sys.cwd matches", sys.cwd() == cwd())

out "=== Test Results: " + str(passed) + " passed, " + str(failed) + " failed ==="
when failed > 0 { process.exit(1) }
