# ============================================================================
# lib/bakchodi/src/auto.ez -- Keyboard & Mouse Automation Utilities
# ============================================================================

use "auto" as auto

# Countdown helper in terminal so the user can switch to target application
export task countdown(seconds = 3, message = "Starting in...") {
    out message
    s = seconds
    while s > 0 {
        out "  " + str(s) + "..."
        stop(1000)
        s = s - 1
    }
    out "  GO!"
}

# Types message, presses Enter, waits delayMs, repeats count times
export task typeMessage(text, count = 1, delayMs = 100) {
    c = count
    when c <= 0 { c = 1 }
    repeat i = 1 to c {
        auto.typeText(text)
        auto.press("enter")
        when i < c and delayMs > 0 {
            stop(delayMs)
        }
    }
}

# Types text character-by-character with realistic typing delay
export task ghostType(text, charDelayMs = 40) {
    buf = buffer(text)
    sz = buf_size(buf)
    repeat i = 0 to sz - 1 {
        ch = substr(text, i, 1)
        auto.typeText(ch)
        when charDelayMs > 0 {
            stop(charDelayMs)
        }
    }
}

export task pressKey(keyStr) {
    auto.press(keyStr)
}

export task hotkey(k1, k2) {
    auto.down(k1)
    auto.press(k2)
    auto.up(k1)
}

export task clickMouse(btn = "left", count = 1) {
    repeat i = 1 to count {
        auto.click(btn)
        when i < count { stop(50) }
    }
}

export task moveMouse(x, y) {
    auto.move(x, y)
}

export task getMousePos() {
    give auto.pos()
}

export task screenSize() {
    give auto.size()
}
