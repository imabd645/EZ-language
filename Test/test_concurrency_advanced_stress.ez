# ============================================================================
# Advanced Concurrency, Channels, Atomics, Mutex, and Async Futures Stress Tests
# ============================================================================

passed = 0
failed = 0

task check(label, actual, expected) {
    when str(actual) == str(expected) {
        out "  PASS: " + label
        passed = passed + 1
    } other {
        out "  FAIL: " + label
        out "    expected: " + str(expected)
        out "    got:      " + str(actual)
        failed = failed + 1
    }
}

# --- 1. Atomic Counter Parallel Increments ---
out "--- 1. Atomic Counter Parallel Increments ---"
counter = new Atomic(0)
futures = []

task workerAdd(counterRef, delta, times) {
    repeat k = 1 to times {
        counterRef.add(delta)
    }
    give true
}

repeat w = 1 to 5 {
    push(futures, spawn(workerAdd, counter, 2, 50)) # 5 * 2 * 50 = 500
}

awaitAll(futures)
finalVal = counter.get()
check("atomic parallel increments", finalVal, 500)

counter.sub(100)
check("atomic sub", counter.get(), 400)
counter.set(42)
check("atomic set", counter.get(), 42)

# --- 2. Mutex Protected Shared Array ---
out "--- 2. Mutex Protected Shared Array ---"
mtx = mutex()
sharedArr = []
mtxFutures = []

task appendWorker(m, arrRef, baseVal) {
    repeat idx = 1 to 10 {
        lock(m, || {
            push(arrRef, baseVal + idx)
        })
    }
    give true
}

push(mtxFutures, spawn(appendWorker, mtx, sharedArr, 100))
push(mtxFutures, spawn(appendWorker, mtx, sharedArr, 200))
push(mtxFutures, spawn(appendWorker, mtx, sharedArr, 300))

awaitAll(mtxFutures)
check("mutex protected array length", len(sharedArr), 30)

# --- 3. Producer-Consumer Pipeline with Channel ---
out "--- 3. Producer-Consumer Channel Pipeline ---"
ch = new Channel()

task producer(chRef, startVal, count) {
    repeat idx = 0 to count - 1 {
        chRef.send(startVal + idx)
    }
    give true
}

prod1 = spawn(producer, ch, 10, 5) # 10, 11, 12, 13, 14
prod2 = spawn(producer, ch, 20, 5) # 20, 21, 22, 23, 24

task consumer(chRef, totalItems) {
    total = 0
    receivedCount = 0
    while receivedCount < totalItems {
        val = chRef.receive()
        when val != nil {
            total = total + val
            receivedCount = receivedCount + 1
        }
    }
    give total
}

cons = spawn(consumer, ch, 10)
awaitAll([prod1, prod2])

consumerTotal = await cons
# sum(10..14) = 60, sum(20..24) = 110, total = 170
check("channel producer consumer sum", consumerTotal, 170)

# --- 4. Channel tryReceive, receiveTimeout, size, and close ---
out "--- 4. Channel Non-blocking & Timeout Methods ---"
ch2 = new Channel()
check("initial channel size", ch2.size(), 0)
check("tryReceive on empty channel", ch2.tryReceive(), nil)

ch2.send("hello")
ch2.send("world")
check("channel size after sends", ch2.size(), 2)
check("tryReceive item 1", ch2.tryReceive(), "hello")
check("channel size after 1 receive", ch2.size(), 1)
check("receiveTimeout item 2", ch2.receiveTimeout(50), "world")
check("receiveTimeout on empty channel (timeout)", ch2.receiveTimeout(50), nil)

check("channel isClosed before close", ch2.isClosed(), false)
ch2.close()
check("channel isClosed after close", ch2.isClosed(), true)
check("receive on closed empty channel", ch2.receive(), nil)

# --- 5. Multi-Stage Channel Processing Pipeline ---
out "--- 5. Multi-Stage Pipeline ---"
# Stage 1 (Generator) -> chStage1 -> Stage 2 (Doubler) -> chStage2 -> Collector
chStage1 = new Channel()
chStage2 = new Channel()

task stage1Gen(outCh, maxN) {
    repeat n = 1 to maxN {
        outCh.send(n)
    }
    outCh.close()
    give true
}

task stage2Doubler(inCh, outCh) {
    while not inCh.isClosed() or inCh.size() > 0 {
        v = inCh.receive()
        when v != nil {
            outCh.send(v * 2)
        }
    }
    outCh.close()
    give true
}

task stage3Collector(inCh) {
    results = []
    while not inCh.isClosed() or inCh.size() > 0 {
        v = inCh.receive()
        when v != nil {
            push(results, v)
        }
    }
    give results
}

f1 = spawn(stage1Gen, chStage1, 5)
f2 = spawn(stage2Doubler, chStage1, chStage2)
f3 = spawn(stage3Collector, chStage2)

collectorResults = await f3
awaitAll([f1, f2])

resStr = ""
get item in collectorResults {
    resStr = resStr + str(item) + " "
}
check("multi-stage pipeline doubled numbers", resStr, "2 4 6 8 10 ")

# --- 6. Async Task Exception Propagation ---
out "--- 6. Async Task Exception Handling ---"
task faultyTask() {
    throw "TaskExplosion"
}

futErr = spawn(faultyTask)
caughtErr = ""
try {
    await futErr
} catch e {
    caughtErr = str(e.message)
}
check("exception caught from await fut", caughtErr, "TaskExplosion")

# --- 7. Parallel Execution via awaitAll Returning Values ---
out "--- 7. Parallel Tasks with awaitAll ---"
task slowCompute(base, power) {
    res = 1
    repeat p = 1 to power {
        res = res * base
    }
    give res
}

fPowers = []
push(fPowers, spawn(slowCompute, 2, 8)) # 256
push(fPowers, spawn(slowCompute, 3, 4)) # 81
push(fPowers, spawn(slowCompute, 5, 3)) # 125

powerResults = awaitAll(fPowers)
powersLog = str(powerResults[0]) + " " + str(powerResults[1]) + " " + str(powerResults[2])
check("parallel power computations", powersLog, "256 81 125")

out ""
out "=============================="
out "Results: " + str(passed) + " passed, " + str(failed) + " failed"
out "=============================="
