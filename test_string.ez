// test_string.ez

print("--- Testing String Concatenation (O(N^2) avoidance) ---")
start = clock()
s = ""
i = 0
while (i < 10000) {
    s = s + "a"
    i = i + 1
}
end = clock()
print("10000 concatenations took: " + (end - start) + " ms")
print("String length: " + len(s))

print("\n--- Testing Property Access (ShortString / Interning) ---")
model TestModel {
    test_prop
    this_is_a_very_large_property_name_for_testing
    init() {}
}

obj = TestModel()
obj.test_prop = 42

start = clock()
i = 0
while (i < 100000) {
    val = obj.test_prop
    i = i + 1
}
end = clock()
print("100000 property accesses took: " + (end - start) + " ms")

print("\n--- Testing Large String Interning ---")
obj.this_is_a_very_large_property_name_for_testing = 100

start = clock()
i = 0
while (i < 100000) {
    val = obj.this_is_a_very_large_property_name_for_testing
    i = i + 1
}
end = clock()
print("100000 large property accesses took: " + (end - start) + " ms")
