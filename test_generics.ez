// test_generics.ez
// This script verifies the new Generics implementation (Phase 1 & Phase 2)

model Dictionary[K, V] {
    // We declare generic properties (Type checker will substitute K and V)
    hidden lastKey: K
    hidden lastValue: V

    init() {}

    task put(key: K, value: V) {
        self.lastKey = key
        self.lastValue = value
        print("Inserted key/value pair!")
    }

    task getLastKey() -> K {
        give self.lastKey
    }
}

task main() {
    print("--- Testing Generics ---")
    
    // Create a dictionary of [String, Int]
    let myDict: Dictionary[string, number] = new Dictionary[string, number]()
    
    // This should pass the type checker!
    myDict.put("Age", 30)

    // Uncommenting the line below should cause a Compile-Time Type Error!
    // myDict.put(30, "Age") 
    
    let key = myDict.getLastKey()
    print(key)
}

main()
