out "--- Testing toString() override ---"

model Person {
    init(name, age) {
        self.name = name
        self.age = age
    }

    task toString() {
        give self.name + " (" + str(self.age) + ")"
    }
}

p = Person("Alice", 30)
out p
out "Person is: " + str(p)
# NOTE: concatenation needs an explicit str() -- EZ does not implicitly coerce a
# non-string operand of `+` (README uses `+ str(x)` throughout, and backtick
# templates desugar to str(...) calls). This line used to read `"Person: " + p`,
# which the type checker correctly rejects.
out "Person: " + str(p)
