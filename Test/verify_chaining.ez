use "pdf"

out "Testing PDF Fluent API (Method Chaining)..."

# Create invoice using the new static init and chaining
invoice = PDF.init("invoice_chained.pdf")
       .addPage()
       .header("INVOICE #2024-001")
       .text(50, 750, "Company Name", 14)
       .text(50, 730, "123 Business St.", 10)
       .text(50, 710, "City, State 12345", 10)
       .save()

out "Chaining test completed successfully."
