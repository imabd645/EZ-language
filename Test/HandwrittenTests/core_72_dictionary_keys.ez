// ============================================================================
// Dictionary Keys Edge Case Tests
// ============================================================================

out "=== Starting Dictionary Keys Test ==="

d = {}

// String keys
d["normal"] = 1

// EZ dictionaries accept string, numeric, and boolean keys.
d[42] = "number key"
d[3.14] = "float key"
d[true] = "true key"
d[false] = "false key"

out "Dict size: " + str(len(d))
out "Dict 42: " + str(d[42])
out "Dict true: " + str(d[true])
out "Dict false: " + str(d[false])

// Nil, arrays, and dictionaries are not valid keys.
rejectedInvalidKeys = true
try { d[nil] = "nil key"; rejectedInvalidKeys = false } catch e { }
try { d[[1, 2]] = "array key"; rejectedInvalidKeys = false } catch e { }
try { d[{ "a": 1 }] = "dict key"; rejectedInvalidKeys = false } catch e { }
when not rejectedInvalidKeys {
    out "FAIL: An invalid dictionary key was accepted"
    exit(1)
}
out "Invalid key types rejected"

// Test removing keys
dictRemove(d, 42)
out "Dict size after remove: " + str(len(d))
out "Dict 42 after remove: " + str(d[42]) // Should be nil

out "=== Dictionary Keys Test Passed ==="
