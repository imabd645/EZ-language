// ============================================================================
// Advanced TypeChecker Edge Cases Test
// ============================================================================

out "=== Starting Advanced TypeChecker Test ==="

task calculate(a: number, b: number, c: number) {
    give a + b + c
}

// 1. Pass a dynamic array into a fixed arity via spread
// Wait, we already did spread!
arr = [1, 2, 3]
res = calculate(...arr)
out "Result via spread: " + str(res)

// 2. Strict type mismatch check
// Let's create an Exception intentionally and catch it? No, TypeChecker happens BEFORE execution.
// If we want the test to run, we have to write valid code.
// Let's just test that the compiler handles complex types.
// A task returning a task that returns a task!
task outer() {
    give || {
        give || {
            give "Inner string"
        }
    }
}

res2 = outer()()()
out "Result from curried tasks: " + res2

out "=== Advanced TypeChecker Test Passed ==="
