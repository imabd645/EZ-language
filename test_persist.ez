@persist("user_data.db")
model User {
    init(name, age) {
        self.name = name
        self.age = age
    }
}

// Write performance test
out "Starting write performance test..."
user1 = User("Alice", 25)

// The old implementation would open/close the DB 100 times here!
// With caching, it opens once and writes 100 times.
i = 0
start=clock()
while i < 100 {
    user1.age = 25 + i
    i = i + 1
}
out "Time taken: " + (clock()-start)
out "Finished write loop."

// Load test
out "Testing Model.load()..."
user2 = User.load()

out "Loaded user name: " + user2.name
out "Loaded user age: " + user2.age

when user2.age == 124 {
    out "Success: user2 matches the last saved state!"
} other {
    out "Error: loaded state does not match."
}
