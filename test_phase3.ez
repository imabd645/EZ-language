out "=== Phase 3: Design & Bounds Checking Test ==="

out "1. Testing Array Bounds Checking..."
arr = [1, 2, 3]
try {
    x = arr[5]
    out "FAIL: Array out of bounds did not throw!"
} catch e {
    out "PASS: Caught array bounds error -> " + str(e)
}

try {
    arr[-1] = 10
    out "FAIL: Array negative index did not throw!"
} catch e {
    out "PASS: Caught array negative index error -> " + str(e)
}

out "2. Testing String Bounds Checking..."
s = "Hello"
try {
    x = s[10]
    out "FAIL: String out of bounds did not throw!"
} catch e {
    out "PASS: Caught string bounds error -> " + str(e)
}

out "3. Testing Buffer Bounds Checking..."
b = buffer(5)
try {
    b[10] = 255
    out "FAIL: Buffer out of bounds did not throw!"
} catch e {
    out "PASS: Caught buffer bounds error -> " + str(e)
}

out "4. Testing Async Memory Limits (8192 Stack Slots)..."
// We spawn an async task that pushes some values to the stack.
// If the 8192 slot stack limitation works, this should run perfectly fine 
// without needing the massive 256K stack.
async task light_worker(id) {
    sum = 0
    repeat i = 1 to 100 {
        sum = sum + i
    }
    give sum
}

fut = light_worker(1)
res = await fut
out "PASS: Async task returned " + str(res)

out "=== Phase 3 Test Complete ==="
