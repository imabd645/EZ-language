// Operator overloading on models must survive the type checker even when both
// operand types are statically known.
model Vec {
    init(x, y) { self.x = x  self.y = y }
    task +(o) { give new Vec(self.x + o.x, self.y + o.y) }
    task *(k) { give new Vec(self.x * k, self.y * k) }
    task show() { give "(" + str(self.x) + "," + str(self.y) + ")" }
}

print((new Vec(1, 2) + new Vec(3, 4)).show())

p: Vec = new Vec(5, 6)
q: Vec = new Vec(7, 8)
print((p + q).show())
print((p * 2).show())
