# Exception Classes Test

try {
    fs.readFile("some_missing_file.txt")
} 
catch FileNotFoundError {
    print("Successfully caught a FileNotFoundError!")
} 
catch e {
    print("Caught something else: " + typeOf(e))
}

try {
    net.http_get("http://localhost:9999/does-not-exist")
} catch NetworkError e {
    print("Successfully caught a NetworkError: " + e.message)
} catch Error e {
    print("It's a general Error: " + e.message)
}

print("\nTrying to throw a custom KeyError...")
try {
    throw KeyError("Key 'user_id' not found in dictionary!")
} catch KeyError {
    print("Caught a native KeyError!")
}

print("\nDone.")
