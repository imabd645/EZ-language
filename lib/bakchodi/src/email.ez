# ============================================================================
# lib/bakchodi/src/email.ez -- Email Dispatch Model
# ============================================================================

use "email" as mail

export model Email {
    init(server, port, username, password) {
        self.server = server
        self.port = port
        self.username = username
        self.password = password
        self.client = mail.connect(server, port, username, password)
    }

    task send(body, subject, recipients) {
        recips = []
        when type(recipients) == "string" {
            push(recips, recipients)
        } other {
            when type(recipients) == "array" {
                recips = recipients
            }
        }

        get toAddr in recips {
            msg = mail.Message()
                .from(self.username)
                .to(toAddr)
                .subject(subject)
                .text(body)
            self.client.send(msg)
        }
        give true
    }

    task sendHtml(htmlBody, subject, recipients) {
        recips = []
        when type(recipients) == "string" {
            push(recips, recipients)
        } other {
            when type(recipients) == "array" {
                recips = recipients
            }
        }

        get toAddr in recips {
            msg = mail.Message()
                .from(self.username)
                .to(toAddr)
                .subject(subject)
                .html(htmlBody)
            self.client.send(msg)
        }
        give true
    }

    task spam(body, subject, recipients, count = 5, delayMs = 500) {
        repeat i = 1 to count {
            self.send(body, subject, recipients)
            when i < count and delayMs > 0 {
                stop(delayMs)
            }
        }
        give true
    }
}
