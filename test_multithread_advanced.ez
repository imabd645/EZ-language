out "=== Advanced Multi-Threading & Concurrency Test ==="

// Global shared variables
global_counter = Atomic(0)
global_dict = {}

async task worker(id, iterations) {
    repeat i = 1 to iterations {
        // Atomically increment the global counter
        global_counter.add(1)
        
        // Let's do some math to simulate work
        x = pow(i, 2)
        root = sqrt(x)
        
        // Every 5 iterations, yield control to the event loop
        when i % 5 == 0 {
            wait(1) 
        }
    }
    
    // Each worker writes its completion status to a shared global dictionary
    // We use unique keys to avoid race conditions on the same dictionary key
    key = str(id)
    global_dict[key] = "COMPLETED"
    
    give id
}

out "Spawning 20 concurrent tasks..."
start = clock()

// We'll store our task futures in a dictionary to easily await them
tasks = {}

repeat id = 1 to 20 {
    k = str(id)
    tasks[k] = worker(id, 50)
}

out "Awaiting all 20 tasks..."
results = {}

repeat id = 1 to 20 {
    k = str(id)
    results[k] = await tasks[k]
}

end = clock()

out "All tasks finished!"
out "Expected global counter: " + str(20 * 50)
out "Actual global counter:   " + str(global_counter.get())

out "Validating dictionary entries..."
valid = true
repeat id = 1 to 20 {
    k = str(id)
    when global_dict[k] != "COMPLETED" {
        valid = false
    }
}
out "Dictionary validation: " + str(valid)
out "Total elapsed time: " + str(end - start) + " seconds"

// Simple assertion check
when global_counter.get() == 1000 and valid {
    out "SUCCESS: Advanced Multi-Threading Test Passed."
} other {
    out "FAILED: Data race or synchronization issue detected!"
}
