task main() {
    t = (1, "hello", 3.14)
    print("Tuple is: ")
    print(t)
    print("t[0]: ")
    print(t[0])
    print("t[1]: ")
    print(t[1])
    print("t[2]: ")
    print(t[2])

    (a, b, c) = t
    print("Destructured:")
    print("a: ")
    print(a)
    print("b: ")
    print(b)
    print("c: ")
    print(c)
}
