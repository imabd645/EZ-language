# A native builtin that FAILS inside a `try` must produce a catchable EZ error,
# not unwind a C++ exception.
#
# dispatchCall used to re-throw the RuntimeError a native raised. That C++ throw
# cannot unwind when the dispatch is running inside the libuv event-loop callback
# (every FFI callback and every ezweb handler): it skips each catch on the stack
# and jumps to a null handler. A helper as ordinary as
#
#     task safeParse(x) { try { give parse_json(x) } catch (e) { give nil } }
#
# therefore killed a whole web server the first time it was handed input the
# parser rejected -- parse_json("5") raises "Failed to parse JSON", the EZ catch
# never got the chance to run, and the process died with
#   [FATAL] Windows Exception 0xc0000005
#
# The server case needs a running server; this file covers the same fault paths
# in ordinary execution, where the catch must still work exactly as before.

_pass = 0
_fail = 0

task check(name, cond) {
    when cond { _pass = _pass + 1  out "  [PASS] " + name }
    other     { _fail = _fail + 1  out "  [FAIL] " + name }
}

out "== a failing native inside try is catchable =="
task safeParse(x) {
    try { give parse_json(x) } catch (e) { give "caught" }
}
check("parse_json rejects a bare scalar", safeParse("5") == "caught")
check("parse_json rejects empty input", safeParse("") == "caught")
check("valid JSON still parses", safeParse("{\"a\": 1}")["a"] == 1)

out ""
out "== the error is visible to the handler =="
msg = ""
try { parse_json("") } catch (e) { msg = str(e) }
check("message is non-empty", len(msg) > 0)

out ""
out "== the try can live in the CALLER =="
task noTryHere(x) { give parse_json(x) }
task callerCatches(x) {
    try { noTryHere(x)  give "no error" } catch (e) { give "caught" }
}
check("caller's try catches it", callerCatches("5") == "caught")
check("caller's try passes valid input", callerCatches("{\"a\":1}") == "no error")

out ""
out "== nested: failing native inside a try inside a try =="
task inner(x) { try { give parse_json(x) } catch (e) { give "inner-caught" } }
task outer(x) { try { give inner(x) } catch (e) { give "outer-caught" } }
check("inner handler wins", outer("5") == "inner-caught")

out ""
out "== other failing natives behave the same =="
task safeNum(x) { try { give num(x) } catch (e) { give -1 } }
check("num on nonsense is caught", safeNum("not-a-number") == -1)
check("num on a numeric string works", safeNum("42") == 42)

out ""
out "== execution continues afterwards =="
check("still running", 1 + 1 == 2)
check("later parse still works", safeParse("[1,2]")[1] == 2)

out ""
out "== an UNCAUGHT native failure still reports and stops =="
# Left uncaught deliberately at the very end: this must print an error and exit
# non-zero rather than crash silently or continue.
out "  (expect a 'Failed to parse JSON' error immediately below)"
out ""
out "========================================"
out " passed: " + str(_pass) + "   failed: " + str(_fail)
out "========================================"
parse_json("definitely not json")
out "UNREACHABLE -- an uncaught native failure did not stop execution"
