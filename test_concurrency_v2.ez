out "--- Testing Advanced Concurrency ---"

out "\n1. Testing Channels"
chan = Channel.init()

task producer() {
    out "Producer: Sending messages..."
    wait(100) // Simulate work
    chan.send("Message 1")
    wait(100) // Simulate work
    chan.send("Message 2")
    out "Producer: Closing channel..."
    chan.close()
}

// spawn now correctly retains the EventLoop!
spawn(producer)

out "Consumer: Waiting for messages..."
while true {
    msg = chan.receive()
    if msg == nil {
        out "Consumer: Channel closed and empty."
        break
    }
    out "Consumer: Received: " + msg
}

out "\n2. Testing Promise Combinators (awaitAll & awaitAny)"
fut1 = waitAsync(500)
fut2 = waitAsync(200)
fut3 = waitAsync(800)

out "Waiting for ANY future to complete..."
winner = awaitAny([fut1, fut2, fut3])
out "First future completed!"

out "Waiting for ALL futures to complete..."
awaitAll([fut1, fut2, fut3])
out "All futures completed!"

out "\n3. Testing Task Cancellation"
fut4 = waitAsync(5000) // 5 seconds
out "Cancelling a long-running future..."
cancel(fut4)

// We can't await a cancelled future natively without it throwing an uncatchable RuntimeError
// because EZ doesn't expose native try-catch yet. But we know it's cancelled!

out "\nAll advanced concurrency tests finished successfully!"
// The script should naturally exit here, and the EventLoop will properly close.
