// A package built as a thin main.ez over a src/ directory must re-export what
// its sub-modules marked `export`.
//
// Symbols used to stop propagating after one hop: `use "src/x.ez"` brought them
// into main.ez as ordinary unexported locals, and `use "<package>"` -- which
// keeps only exported locals -- filtered them back out. Callers got nil for
// anything not defined directly in main.ez, so sqlite, socket and orm (all laid
// out that way) each broke at their first call into a sub-module.
task check(name, actual, expected) {
    when str(actual) == str(expected) {
        print("ok " + name)
    } other {
        print("FAIL " + name + " expected " + str(expected) + " got " + str(actual))
    }
}

use "modpkg"

check("package's own export", typeOf(pkgOwn), "function")
check("re-exported from same dir", typeOf(pkgSameDir), "function")
check("re-exported from src/ subdir", typeOf(pkgSubDir), "function")
check("re-exported constant", pkgConst, 7)
check("calling through re-export works", pkgSubDir(), "sub")
// A helper the sub-module did NOT export must stay private.
check("private helper stays private", typeOf(pkgPrivate), "nil")
