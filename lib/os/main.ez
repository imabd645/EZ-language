// ============================================================================
// ezos -- Cross-Platform System Utilities for EZ Language (v2.0)
// Supports Windows, Linux, and macOS
//
// NOTE: Does NOT shadow or define 'os', which is a reserved built-in function.
//
// Usage:
//   use "os" as *
//   out cwd()
//   out pid()
//   out homedir()
//   out env.get("PATH")
//   out path.join("a", "b")
//   out sys.cpuCores()
// ============================================================================

use "src/errors.ez"
use "src/env.ez"
use "src/path.ez"
use "src/process.ez"
use "src/clipboard.ez"
use "src/shell.ez"
use "src/system.ez"
use "src/dirs.ez"

// Submodule instance exports
export env = OSEnv()
export path = OSPath()
export process = OSProcess()
export clipboard = OSClipboard()
export shell = OSShell()
export dirs = OSDirs()

_sysInstance = OSSystem()

export model System {
    init() {
        self.env = env
        self.path = path
        self.process = process
        self.clipboard = clipboard
        self.shell = shell
        self.dirs = dirs
        self._sys = _sysInstance
    }

    // --- Core Platform API ---
    task platform() { give self._sys.platform() }
    task isWindows() { give self._sys.isWindows() }
    task isMacOS() { give self._sys.isMacOS() }
    task isLinux() { give self._sys.isLinux() }
    task isPosix() { give self._sys.isPosix() }

    // --- System & Hardware Info ---
    task uptime() { give self._sys.uptime() }
    task totalMemory() { give self._sys.totalMemory() }
    task freeMemory() { give self._sys.freeMemory() }
    task memory() { give self._sys.memory() }
    task cpuCores() { give self._sys.cpuCores() }
    task arch() { give self._sys.arch() }
    task pid() { give self._sys.pid() }
    task userName() { give self._sys.userName() }
    task computerName() { give self._sys.computerName() }
    task hostname() { give self._sys.hostname() }
    task executable() { give self._sys.executable() }
    task version() { give self._sys.version() }

    // --- Filesystem & Directories ---
    task cwd() { give self._sys.cwd() }
    task chdir(p) { give self._sys.chdir(p) }
    task sleep(ms) { self._sys.sleep(ms) }
    task homedir() { give self.dirs.home() }
    task tmpdir() { give self.dirs.temp() }
}

export sys = System()

// Top-level function exports for direct access
export task getPlatform() { give _sysInstance.platform() }
export task isWindows() { give _sysInstance.isWindows() }
export task isMacOS() { give _sysInstance.isMacOS() }
export task isLinux() { give _sysInstance.isLinux() }
export task isPosix() { give _sysInstance.isPosix() }

export task uptime() { give _sysInstance.uptime() }
export task totalMemory() { give _sysInstance.totalMemory() }
export task freeMemory() { give _sysInstance.freeMemory() }
export task memory() { give _sysInstance.memory() }
export task cpuCores() { give _sysInstance.cpuCores() }
export task arch() { give _sysInstance.arch() }
export task pid() { give _sysInstance.pid() }
export task userName() { give _sysInstance.userName() }
export task computerName() { give _sysInstance.computerName() }
export task hostname() { give _sysInstance.hostname() }
export task executable() { give _sysInstance.executable() }
export task version() { give _sysInstance.version() }

export task cwd() { give _sysInstance.cwd() }
export task chdir(p) { give _sysInstance.chdir(p) }
export task sleep(ms) { _sysInstance.sleep(ms) }
export task homedir() { give dirs.home() }
export task tmpdir() { give dirs.temp() }
