out "--- Testing Advanced Concurrency & Thread Safety ---"

shared_arr = []

task add_to_array() {
    wait(10)
    i = 0
    while i < 50 {
        push(shared_arr, i)
        i = i + 1
    }
}

out "Spawning tasks to mutate shared array concurrently..."
fut1 = spawn(add_to_array)
fut2 = spawn(add_to_array)
fut3 = spawn(add_to_array)

out "Waiting for array tasks to complete..."
awaitAll([fut1, fut2, fut3])

out "Expected array size: 150"
out "Actual array size: " + str(len(shared_arr))
when len(shared_arr) == 150 {
    out "Array insertion is perfectly thread-safe!\n"
}

out "--- Testing Atomics ---"
atm = Atomic(0)

task inc_atomic() {
    wait(5)
    i = 0
    while i < 50 {
        atm.add(1)
        i = i + 1
    }
}
fa1 = spawn(inc_atomic)
fa2 = spawn(inc_atomic)
fa3 = spawn(inc_atomic)
awaitAll([fa1, fa2, fa3])

out "Expected atomic count: 150"
out "Actual atomic count: " + str(atm.get())
when atm.get() == 150 {
    out "Atomic increment is perfectly thread-safe!\n"
}

out "--- Testing Channels ---"
ch = Channel()

task producer() {
    wait(10)
    ch.send("Message A")
    wait(10)
    ch.send("Message B")
    ch.close()
}

task consumer() {
    msg = ch.receive()
    while msg != nil {
        out "Consumer Received: " + str(msg)
        msg = ch.receive()
    }
    out "Consumer finished."
}

fc1 = spawn(consumer)
fp1 = spawn(producer)
awaitAll([fc1, fp1])

out "\nAll advanced concurrency tests finished successfully!"
