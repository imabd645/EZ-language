out "=== Starting HTTP Fetch Test ==="

try {
    out "Fetching..."
    fut = fetch("https://jsonplaceholder.typicode.com/todos/1")
    res = await fut
    out "Response: " + str(res)
    
    // Parse json
    data = parse_json(res)
    out "Parsed JSON title: " + data["title"]
    out "PASS: Successfully fetched and parsed JSON over HTTPS!"
} catch e {
    out "Caught Error (could be offline): " + str(e)
}

out "=== HTTP Fetch Test Finished ==="
