# ============================================================================
# Test: Permission scanner detection of File(...) constructor calls without new
# ============================================================================

# 1. Direct File constructor with write mode (no new)
f1 = File("output_direct.txt", "w")
when f1 != nil {
    f1.write("test content")
    f1.close()
}

# 2. Direct File constructor with read mode (no new)
f2 = File("input_direct.txt", "r")
when f2 != nil {
    f2.close()
}

# 3. New File constructor with write mode (with new)
f3 = new File("output_new.txt", "w")
when f3 != nil {
    f3.close()
}

out "PASS: File constructor calls executed successfully"
