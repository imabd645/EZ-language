np = import("lib/numpy.ez")

out "--- Testing FFI NumPy ---"

# Create a Tensor from list
a = np.Tensor.from_list([1.0, 2.0, 3.0, 4.0])
b = np.Tensor.from_list([5.0, 6.0, 7.0, 8.0])

out "a = " + str(a)
out "b = " + str(b)

# Addition
c = a.add(b)
out "a + b = " + str(c)

# Multiplication
d = a.mul(b)
out "a * b = " + str(d)

# Dot product
dot_prod = a.dot(b)
out "a . b = " + str(dot_prod)

# Matrix multiplication
out "\n--- Matrix Multiplication ---"
m1 = np.Tensor.from_list([1.0, 2.0, 3.0, 4.0])
m1.shape = [2, 2]

m2 = np.Tensor.from_list([2.0, 0.0, 1.0, 2.0])
m2.shape = [2, 2]

out "m1 = " + str(m1)
out "m2 = " + str(m2)

m3 = m1.matmul(m2)
out "m1 @ m2 = " + str(m3)

# Performance Benchmark
out "\n--- Performance Benchmark ---"
# Create a large tensor
size = 1000000
big1 = np.Tensor.zeros([size])
big2 = np.Tensor.ones([size])

# Time FFI
start = clock()
big3 = big1.add(big2)
ffi_time = clock() - start
out "FFI Add (1 million elements): " + str(ffi_time) + " ms"

# Time native EZ loop
start = clock()
arr1 = []
arr2 = []
i = 0
while i < size {
    arr1.push(0.0)
    arr2.push(1.0)
    i = i + 1
}
alloc_time = clock() - start

start = clock()
arr3 = []
i = 0
while i < size {
    arr3.push(arr1[i] + arr2[i])
    i = i + 1
}
ez_time = clock() - start

out "Native EZ Array Add (1 million elements): " + str(ez_time) + " ms"
out "Native EZ Array Allocation overhead: " + str(alloc_time) + " ms"
if ez_time > 0 {
    out "FFI Speedup: " + str(ez_time / ffi_time) + "x faster"
}
