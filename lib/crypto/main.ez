// ============================================================================
// ezcrypto (v2.0) — Unified Cross-Platform Cryptographic Suite for EZ
// ============================================================================
// Features:
//   - Hex           — Hex encoding, decoding, timingSafeEqual
//   - Base64        — Standard & URL-Safe RFC 4648 encoding/decoding
//   - SecureRandom  — OS-backed CSPRNG, random ints/floats, tokens, UUID v4
//   - Hash          — SHA-256, SHA-512, SHA-384, SHA-1, MD5
//   - HMAC          — Keyed-Hash MAC (RFC 2104 / 4231)
//   - AES           — AES-128/192/256 CBC with PKCS#7
//   - PBKDF2        — RFC 2898 / 6070 key derivation
//   - Crypto        — Unified static facade
// ============================================================================

use "src/ffi.ez"
use "src/hex.ez"
use "src/base64.ez"
use "src/random.ez"
use "src/hash.ez"
use "src/hmac.ez"
use "src/cipher.ez"
use "src/pbkdf2.ez"


// ── RC4 Stream Cipher (Backward Compatibility) ──────────────────────────────
export model RC4 {
    static task process(key, data) {
        keyLen = len(key)
        when keyLen == 0 { give data }
        S = []
        repeat i = 0 to 255 { push(S, i) }
        j = 0
        repeat i = 0 to 255 {
            kByte = ord(substr(key, i % keyLen, 1))
            j = (j + S[i] + kByte) % 256
            temp = S[i]
            S[i] = S[j]
            S[j] = temp
        }
        i = 0
        j = 0
        res = []
        dLen = len(data)
        isStr = typeOf(data) == "string"
        repeat k = 0 to dLen - 1 {
            i = (i + 1) % 256
            j = (j + S[i]) % 256
            temp = S[i]
            S[i] = S[j]
            S[j] = temp
            K = S[(S[i] + S[j]) % 256]
            byteVal = isStr ? ord(substr(data, k, 1)) : data[k]
            push(res, byteVal ^ K)
        }
        give res
    }

    static task encrypt(key, plaintext) {
        bytes = RC4.process(key, plaintext)
        give Base64.encode(bytes)
    }

    static task decrypt(key, base64Cipher) {
        cipherBytes = Base64.decodeToBytes(base64Cipher)
        plainBytes = RC4.process(key, cipherBytes)
        res = ""
        get b in plainBytes { res = res + chr(b) }
        give res
    }
}

export model Crypto {
    // ── Hashing ─────────────────────────────────────────────────────────────
    static task sha256(data) { give Hash.sha256(data) }
    static task sha512(data) { give Hash.sha512(data) }
    static task sha384(data) { give Hash.sha384(data) }
    static task sha1(data)   { give Hash.sha1(data) }
    static task md5(data)    { give Hash.md5(data) }

    // ── HMAC ────────────────────────────────────────────────────────────────
    static task hmacSha256(key, message) { give HMAC.sha256(key, message) }
    static task hmacSha512(key, message) { give HMAC.sha512(key, message) }
    static task hmacSha384(key, message) { give HMAC.sha384(key, message) }
    static task hmacSha1(key, message)   { give HMAC.sha1(key, message) }
    static task hmacMd5(key, message)    { give HMAC.md5(key, message) }

    // ── Symmetric Encryption (AES-CBC) ──────────────────────────────────────
    static task encrypt(key, iv, plaintext) { give AES.encrypt(key, iv, plaintext) }
    static task decrypt(key, iv, ciphertext) { give AES.decrypt(key, iv, ciphertext) }
    static task rc4Encrypt(key, plaintext) { give RC4.encrypt(key, plaintext) }
    static task rc4Decrypt(key, ciphertext) { give RC4.decrypt(key, ciphertext) }

    // ── Key Derivation (PBKDF2) ─────────────────────────────────────────────
    static task pbkdf2(password, salt, iterations = 100000, keyLen = 32) {
        give PBKDF2.derive(password, salt, iterations, keyLen)
    }

    // ── Random Generation & UUID ────────────────────────────────────────────
    static task randomBytes(count) { give SecureRandom.bytes(count) }
    static task randomHex(numBytes) { give SecureRandom.hex(numBytes) }
    static task randomToken(numBytes) { give SecureRandom.token(numBytes) }
    static task uuid() { give SecureRandom.uuid4() }

    // ── Base64 & Hex ────────────────────────────────────────────────────────
    static task base64Encode(data) { give Base64.encode(data) }
    static task base64Decode(data) { give Base64.decode(data) }
    static task hexEncode(data)    { give Hex.encode(data) }
    static task hexDecode(data)    { give Hex.decode(data) }
    static task timingSafeEqual(a, b) { give Hex.timingSafeEqual(a, b) }
}
