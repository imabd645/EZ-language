out "--- Testing EZ Concurrency Primitives ---"

out "\n1. Testing Atomics"
// Create an atomic counter initialized to 0
counter = Atomic(0) // wait, Atomic() doesn't exist, we must use Atomic().init(0) but Atomic is a class. Let's see:
// The builtin registers "Atomic" as a class and adds .init().
// Wait, the builtin definition:
// auto atomicClass = std::make_shared<EZClass>("Atomic");
// atomicClass->methods["init"] = ...
// So `counter = Atomic().init(0)`

counter = Atomic().init(0)

task incrementer() {
    i = 0
    while i < 100 {
        counter.add(1)
        i += 1
    }
}

// Spawn multiple threads
spawn(incrementer)
spawn(incrementer)
spawn(incrementer)

// We use the synchronous wait() to give the threads time to finish,
// because spawn() currently detaches threads without retaining the EventLoop.
wait(500)

out "Counter should be 300:"
out counter.get()


out "\n2. Testing waitAsync and Await"
// This tests EZFuture internally
fut = waitAsync(100)
out "Waiting for future..."
await(fut)
out "Future resolved!"

out "\nAll concurrency tests completed!"
