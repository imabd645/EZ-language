model MathUtil {
    static PI = 3.14159

    static task square(x) {
        give x * x
    }

    static task circleArea(r) {
        # Static members are reached through the model name, not `self` -- a
        # static task has no instance, so `self` is invalid there (README,
        # "Static Members" uses `Counter.count`). This previously read
        # `self.PI * self.square(r)` and failed to compile.
        give MathUtil.PI * MathUtil.square(r)
    }
}

out "--- Testing static members ---"
out "PI: " + str(MathUtil.PI)
out "Square of 4: " + str(MathUtil.square(4))
out "Circle Area (r=2): " + str(MathUtil.circleArea(2))

MathUtil.PI = 3.14
out "Modified PI: " + str(MathUtil.PI)
