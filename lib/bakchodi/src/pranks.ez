# ============================================================================
# lib/bakchodi/src/pranks.ez -- Fun Pranks and Audio/URL helpers
# ============================================================================

use "auto" as auto

__k32 = os_load_lib("Kernel32.dll")
__beep_func = os_get_func(__k32, "Beep")

export task beep(freq = 1000, durationMs = 200) {
    when __beep_func != nil and __beep_func != 0 {
        os_call(__beep_func, "int", freq, durationMs)
    }
}

export task beeper(count = 3, freq = 1000, durationMs = 150) {
    repeat i = 1 to count {
        beep(freq, durationMs)
        when i < count { stop(100) }
    }
}

export task crazyMouse(durationSec = 3) {
    res = auto.size()
    maxX = res["width"]
    maxY = res["height"]
    steps = durationSec * 20
    repeat i = 1 to steps {
        rx = randint(0, maxX)
        ry = randint(0, maxY)
        auto.move(rx, ry)
        stop(50)
    }
}

export task openUrl(url) {
    system("start \"\" \"" + url + "\"")
}

export task rickroll() {
    openUrl("https://www.youtube.com/watch?v=dQw4w9WgXcQ")
}

export task sleep(ms) {
    stop(ms)
}

export task wait(ms) {
    stop(ms)
}
