// ============================================================================
// Buffer & Memory Edge Case Tests
// ============================================================================

use "buffer"

out "=== Starting Buffer Edge Cases Test ==="

b = buffer.Buffer(16)

// Normal writes
b.writeUInt8(0, 255)
b.writeInt32LE(1, -100000)
b.writeFloat64LE(5, 3.14159)

out "Float64 read: " + str(b.readFloat64LE(5))

// Out of bounds writes - should throw cleanly instead of segfaulting
try {
    b.writeUInt32LE(14, 42) // Requires 4 bytes, but only 2 left (14, 15)
    out "FAIL: Should have thrown out of bounds"
} catch e {
    out "PASS: Caught out of bounds write"
}

// Out of bounds reads
try {
    val = b.readInt64LE(10) // Requires 8 bytes, but only 6 left
    out "FAIL: Should have thrown out of bounds"
} catch e {
    out "PASS: Caught out of bounds read"
}

// String boundaries
b.writeString(0, "Hello World")
sliced = b.toString(0, 5)
out "String slice: " + sliced

out "=== Buffer Edge Cases Passed ==="
